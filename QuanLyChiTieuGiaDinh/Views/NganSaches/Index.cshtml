@model IEnumerable<QuanLyChiTieuGiaDinh.Models.NganSach>
@{
    ViewData["Title"] = "Quản lý ngân sách cá nhân";
    int thangChon = ViewBag.ThangChon;
    int namChon = ViewBag.NamChon;
    var danhSachTinhToan = ViewBag.DanhSachTinhToan as IEnumerable<dynamic>;
}

<div class="container-fluid mt-4 mb-5" style="max-width: 1200px;">

    <!-- THÔNG BÁO -->
    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 bg-success bg-opacity-10 text-success rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["ThongBao"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- TIÊU ĐỀ & NÚT TẠO MỚI -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold text-success mb-1">
                Quản lý ngân sách cá nhân
            </h3>
            <p class="text-secondary mb-0">Theo dõi, kiểm soát hạn mức chi tiêu theo từng danh mục hàng tháng.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success rounded-3 px-4 py-2 shadow-sm fw-medium">
                <i class="bi bi-plus-lg me-1"></i> Tạo ngân sách mới
            </a>
        </div>
    </div>

    <!-- BỘ LỌC THỜI GIAN (ĐẶT GỌN GÀNG TRÊN MỘT HÀNG) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="d-flex align-items-end gap-3 flex-wrap">
                <div>
                    <label class="form-label text-secondary small mb-1 fw-medium">Chọn tháng</label>
                    <select name="thang" class="form-select border bg-white rounded-3" style="min-width: 140px;">
                        @for (int i = 1; i <= 12; i++)
                        {
                            if (i == thangChon)
                            {
                                <option value="@i" selected>Tháng @i</option>
                            }
                            else
                            {
                                <option value="@i">Tháng @i</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label text-secondary small mb-1 fw-medium">Chọn năm</label>
                    <input type="number" name="nam" class="form-control border bg-white rounded-3" value="@namChon" min="2020" max="2100" style="width: 120px;" />
                </div>

                <div>
                    <button type="submit" class="btn btn-success rounded-3 px-4 shadow-sm">
                        <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- DANH SÁCH NGÂN SÁCH (GRID CARD) -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @if (danhSachTinhToan != null && danhSachTinhToan.Any())
        {
            foreach (var item in danhSachTinhToan)
            {
                var ns = item.NganSach as QuanLyChiTieuGiaDinh.Models.NganSach;
                decimal daChi = item.DaChi;
                decimal conLai = item.ConLai;
                decimal phanTram = item.PhanTramDaDung;
                var phanTramHienThi = Math.Min(phanTram, 100);
                string mauTienDo = item.MauTienDo;
                string loiCanhBao = item.LoiCanhBaoDuBao;

                <div class="col">
                    <div class="card h-100 border rounded-4 shadow-sm" style="border-color: #f0f0f0;">
                        <div class="card-body p-4 d-flex flex-column">

                            <!-- Tiêu đề thẻ & Menu dropdown chỉnh sửa/xóa -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="pe-2 overflow-hidden">
                                    <h5 class="fw-bold text-dark mb-1 text-truncate" title="@ns.TenNganSach">@ns.TenNganSach</h5>
                                    @if (ns.DanhMuc != null)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-normal text-truncate d-inline-block" style="max-width: 100%;">
                                            @(!string.IsNullOrEmpty(ns.DanhMuc.BieuTuong) ? ns.DanhMuc.BieuTuong + " " : "")@ns.DanhMuc.TenDanhMuc
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border rounded-pill px-3 py-1 fw-normal">Tất cả danh mục</span>
                                    }
                                </div>

                                <div class="dropdown flex-shrink-0">
                                    <button class="btn btn-sm btn-light rounded-circle text-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 32px; height: 32px; padding: 0;">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                        <li><a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@ns.MaNganSach"><i class="bi bi-pencil me-2 text-primary"></i> Sửa</a></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@ns.MaNganSach" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa ngân sách này?');">
                                                <button type="submit" class="dropdown-item py-2 text-danger"><i class="bi bi-trash me-2"></i> Xóa</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Khối thông tin Hạn mức -->
                            <div class="bg-light rounded-3 p-3 mb-4 mt-2">
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                                    <span class="text-secondary small">Hạn mức:</span>
                                    <span class="fw-bold text-dark fs-6">@ns.SoTienHanMuc.ToString("N0") ₫</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-secondary small">Còn lại:</span>
                                    @if (conLai >= 0)
                                    {
                                        <span class="fw-bold text-success fs-6">@conLai.ToString("N0") ₫</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-danger fs-6">Vượt @Math.Abs(conLai).ToString("N0") ₫</span>
                                    }
                                </div>
                            </div>

                            <!-- Thanh Tiến độ chi tiêu -->
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-end mb-2">
                                    <span class="text-secondary small">Đã chi: <strong class="text-dark fs-6">@daChi.ToString("N0") ₫</strong></span>
                                    <span class="fw-bold text-secondary small">@phanTram.ToString("0.#")%</span>
                                </div>
                                <div class="progress rounded-pill bg-light border" style="height: 8px;">
                                    <div class="progress-bar @mauTienDo rounded-pill"
                                         role="progressbar"
                                         style="width: @phanTramHienThi.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(loiCanhBao))
                                {
                                    <div class="alert alert-danger p-2 mt-3 mb-0 small border-0 rounded-3 d-flex align-items-center">
                                        <i class="bi bi-exclamation-circle-fill me-2 fs-6"></i>
                                        <span>@loiCanhBao</span>
                                    </div>
                                }
                            </div>

                            <!-- Nút xem chi tiết giao dịch -->
                            <div class="mt-4 pt-3 border-top">
                                <a asp-action="Details" asp-route-id="@ns.MaNganSach" class="btn btn-light w-100 rounded-3 text-secondary fw-medium shadow-sm" style="background-color: #f8f9fa;">
                                    Xem chi tiết giao dịch
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-light">
                    <i class="bi bi-wallet2 text-secondary opacity-50 display-3 mb-3"></i>
                    <h5 class="text-secondary fw-bold">Chưa có ngân sách cá nhân nào</h5>
                    <p class="text-muted mb-4">Bạn chưa thiết lập khoản ngân sách nào cho tháng @thangChon/@namChon.</p>
                    <div class="d-flex justify-content-center">
                        <a asp-action="Create" class="btn btn-success rounded-3 px-4 shadow-sm">
                            <i class="bi bi-plus-lg me-1"></i> Tạo ngân sách ngay
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>