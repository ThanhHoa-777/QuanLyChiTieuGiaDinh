@model QuanLyChiTieuGiaDinh.Models.NganSach

@{
    ViewData["Title"] = "Chỉnh sửa ngân sách";
}

<div class="container mt-4 mb-5" style="max-width: 700px;">
    <!-- FORM CARD CHÍNH (GỘP CHUNG TIÊU ĐỀ VÀ FORM VÀO MỘT KHỐI) -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">

            <!-- TIÊU ĐỀ & NÚT QUAY LẠI -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold text-success mb-1">
                        <i class="bi bi-pencil-square me-2"></i>Sửa ngân sách cá nhân
                    </h4>
                    <p class="text-muted small mb-0">Cập nhật hạn mức hoặc thông tin chi tiêu</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3 px-3">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <input type="hidden" asp-for="MaNganSach" />
                <input type="hidden" asp-for="MaGiaDinh" />
                <input type="hidden" asp-for="MaNguoiTao" />
                <input type="hidden" asp-for="TrangThai" />
                <input type="hidden" asp-for="NgayTao" />
                <input type="hidden" asp-for="IsGiaDinh" />

                <!-- TRƯỜNG THÔNG TIN CỐ ĐỊNH (READ-ONLY) -->
                <div class="row bg-light rounded-3 p-3 mb-4 mx-0 border align-items-center">
                    <div class="col-6 border-end">
                        <span class="text-muted small d-block">Chu kỳ thời gian</span>
                        <span class="fw-bold text-dark">Tháng @Model.Thang / @Model.Nam</span>
                    </div>
                    <div class="col-6 ps-3">
                        <span class="text-muted small d-block">Danh mục áp dụng</span>
                        <span class="fw-bold text-dark text-truncate d-block">@(Model.MaDanhMuc.HasValue? Model.DanhMuc?.TenDanhMuc : "Tất cả danh mục")</span>
                    </div>
                </div>

                <!-- CÁC TRƯỜNG CHO PHÉP SỬA -->
                <div class="mb-3">
                    <label asp-for="TenNganSach" class="form-label fw-medium text-secondary small">Tên ngân sách <span class="text-danger">*</span></label>
                    <input asp-for="TenNganSach" class="form-control rounded-3" required />
                    <span asp-validation-for="TenNganSach" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label asp-for="SoTienHanMuc" class="form-label fw-medium text-secondary small">Số tiền hạn mức (₫) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light rounded-start-3 border-end-0"><i class="bi bi-cash text-success"></i></span>
                            <input asp-for="SoTienHanMuc" type="number" class="form-control rounded-end-3 border-start-0 ps-2" min="0" step="1000" required />
                        </div>
                        <span asp-validation-for="SoTienHanMuc" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NguongCanhBaoPhanTram" class="form-label fw-medium text-secondary small">Ngưỡng cảnh báo (%)</label>
                        <input asp-for="NguongCanhBaoPhanTram" type="number" class="form-control rounded-3" min="1" max="100" />
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Tỷ lệ % để báo đỏ</div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label asp-for="NgayBatDau" class="form-label fw-medium text-secondary small">Ngày bắt đầu</label>
                        <input asp-for="NgayBatDau" type="date" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NgayKetThuc" class="form-label fw-medium text-secondary small">Ngày kết thúc</label>
                        <input asp-for="NgayKetThuc" type="date" class="form-control rounded-3" />
                    </div>
                </div>

                <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-success btn-lg rounded-3 shadow-sm py-3 fw-medium">
                        <i class="bi bi-save me-2"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>