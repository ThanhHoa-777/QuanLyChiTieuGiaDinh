@{ ViewData["Title"] = "Đổi mật khẩu - ShopSon"; }
<div style="max-width:420px;margin:30px auto;background:#fff;border-radius:16px;padding:30px;box-shadow:0 4px 20px rgba(0,0,0,.06);">
    <h2 style="text-align:center;color:#d63384;margin-bottom:18px;">🔑 Đổi Mật Khẩu</h2>
    @if (ViewBag.Loi != null)
    {
        <div style="background:#fce4ec;color:#c62828;border-radius:8px;padding:10px 12px;margin-bottom:12px;font-size:14px;">@ViewBag.Loi</div>
    }
    <form asp-controller="TaiKhoan" asp-action="DoiMatKhau" method="post">
        <input name="matKhauCu" type="password" placeholder="Mật khẩu hiện tại" class="o-nhap" />
        <input name="matKhauMoi" type="password" placeholder="Mật khẩu mới" class="o-nhap" />
        <input name="matKhauMoiLai" type="password" placeholder="Nhập lại mật khẩu mới" class="o-nhap" />
        <button type="submit" class="btn-mua-ngay" style="width:100%;padding:12px;border:none;cursor:pointer;">Đổi mật khẩu</button>
    </form>
</div>
<style>.o-nhap { width:100%; padding:11px 12px; border:1.5px solid #f8d7da; border-radius:8px; margin-bottom:12px; font:inherit; }</style>
