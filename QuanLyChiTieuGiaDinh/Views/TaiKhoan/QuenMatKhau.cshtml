@{ ViewData["Title"] = "Quên mật khẩu - ShopSon"; }
<div style="max-width:420px;margin:30px auto;background:#fff;border-radius:16px;padding:30px;box-shadow:0 4px 20px rgba(0,0,0,.06);">
    <h2 style="text-align:center;color:#d63384;margin-bottom:6px;">🔐 Quên Mật Khẩu</h2>
    <p style="text-align:center;color:#888;font-size:13px;margin-bottom:18px;">Nhập tên đăng nhập, ShopSon sẽ gửi mã 6 số tới email trong hồ sơ của tài khoản đó.</p>
    @if (ViewBag.Loi != null)
    {
        <div style="background:#fce4ec;color:#c62828;border-radius:8px;padding:10px 12px;margin-bottom:12px;font-size:14px;">@ViewBag.Loi</div>
    }
    <form asp-controller="TaiKhoan" asp-action="QuenMatKhau" method="post">
        <input name="tenDangNhap" placeholder="Tên đăng nhập" value="@ViewBag.TenDangNhap" autofocus required class="o-nhap" />
        <button type="submit" class="btn-mua-ngay" style="width:100%;padding:12px;border:none;cursor:pointer;">📧 Gửi mã xác nhận</button>
    </form>
    <p style="text-align:center;margin-top:14px;font-size:14px;"><a asp-controller="TaiKhoan" asp-action="DangNhap" style="color:#d63384;font-weight:700;">← Quay lại đăng nhập</a></p>
</div>
<style>.o-nhap { width:100%; padding:11px 12px; border:1.5px solid #f8d7da; border-radius:8px; margin-bottom:12px; font:inherit; }</style>
