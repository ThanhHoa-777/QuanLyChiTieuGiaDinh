@model QuanLyChiTieuGiaDinh.Models.DanhMuc

@{
    ViewData["Title"] = "Sửa danh mục";

    // Đã có giao dịch thì không cho đổi loại (tránh sai lệch báo cáo)
    bool khoaLoai = ViewBag.KhoaLoai ?? false;

    var emojis = new[]
    {
        "🍔", "🍜", "🍕", "🍚", "☕",
        "🏠", "💡", "💧", "📱", "🌐",
        "🚗", "🏍️", "🚌", "⛽", "🚕",
        "🛒", "🛍️", "👕", "👟", "💄",
        "🎓", "📚", "💊", "🏥", "⚽",
        "🎮", "🎬", "✈️", "🏖️", "🐶",
        "💰", "💵", "🎁", "💳", "🏦"
    };
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <!-- TIÊU ĐỀ -->

                <div class="card-header bg-warning">

                    <h3 class="mb-0">

                        <i class="bi bi-pencil-square"></i>

                        Sửa danh mục

                    </h3>

                </div>


                <div class="card-body">

                    <!-- THÔNG BÁO QUYỀN -->

                    <div class="alert alert-warning">

                        <i class="bi bi-person-check"></i>

                        Chỉ <strong>chủ hộ</strong> mới có quyền
                        chỉnh sửa danh mục của hộ gia đình.

                    </div>


                    <form asp-action="Edit" method="post">

                        <!-- ID -->

                        <input type="hidden"
                               asp-for="MaDanhMuc" />


                        <!-- VALIDATION -->

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <!-- TÊN DANH MỤC -->

                        <div class="mb-3">

                            <label asp-for="TenDanhMuc"
                                   class="form-label fw-bold">

                                Tên danh mục

                            </label>

                            <input asp-for="TenDanhMuc"
                                   class="form-control" />

                            <span asp-validation-for="TenDanhMuc"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- LOẠI DANH MỤC -->

                        <div class="mb-3">

                            <label asp-for="LoaiDanhMuc"
                                   class="form-label fw-bold">

                                Loại danh mục

                            </label>

                            <select asp-for="LoaiDanhMuc"
                                    class="form-select"
                                    disabled="@khoaLoai">

                                <option value="ChiTieu">
                                    Chi tiêu
                                </option>

                                <option value="ThuNhap">
                                    Thu nhập
                                </option>

                            </select>

                            @if (khoaLoai)
                            {
                                <input type="hidden" name="LoaiDanhMuc" value="@Model.LoaiDanhMuc" />
                                <div class="form-text">
                                    <i class="bi bi-lock"></i> Danh mục đã phát sinh giao dịch nên không thể đổi loại.
                                </div>
                            }

                            <span asp-validation-for="LoaiDanhMuc"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- BIỂU TƯỢNG -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">

                                Biểu tượng

                            </label>


                            <!-- Giá trị emoji được chọn -->

                            <input asp-for="BieuTuong"
                                   type="hidden"
                                   id="BieuTuong" />


                            <div class="border rounded p-3">

                                <div class="d-flex flex-wrap gap-2">

                                    @foreach (var emoji in emojis)
                                    {
                                        <button type="button"
                                                class="btn @(Model.BieuTuong == emoji ? "btn-primary" : "btn-light") border emoji-button"
                                                style="font-size: 24px; width: 52px; height: 52px;"
                                                data-emoji="@emoji">

                                            @emoji

                                        </button>
                                    }

                                </div>

                            </div>


                            <!-- EMOJI ĐANG CHỌN -->

                            <div class="mt-3">

                                <span class="fw-bold">

                                    Biểu tượng hiện tại:

                                </span>

                                <span id="emojiPreview"
                                      class="ms-2"
                                      style="font-size: 30px;">

                                    @(string.IsNullOrEmpty(Model.BieuTuong)
                                                                        ? "Chưa chọn"
                                                                        : Model.BieuTuong)

                                </span>

                            </div>

                            <span asp-validation-for="BieuTuong"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- NÚT -->

                        <div class="mt-4 d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-circle"></i>

                                Lưu thay đổi

                            </button>

                            <a asp-action="Details"
                               asp-route-id="@Model.MaDanhMuc"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>

                                Quay lại

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.querySelectorAll(".emoji-button").forEach(function (button) {

            button.addEventListener("click", function () {

                var emoji = this.getAttribute("data-emoji");

                // Lưu emoji được chọn
                document.getElementById("BieuTuong").value = emoji;

                // Hiển thị emoji đang chọn
                document.getElementById("emojiPreview").textContent = emoji;

                // Bỏ trạng thái chọn của tất cả emoji
                document.querySelectorAll(".emoji-button").forEach(function (item) {

                    item.classList.remove("btn-primary");

                    item.classList.add("btn-light");

                });

                // Đánh dấu emoji vừa chọn
                this.classList.remove("btn-light");

                this.classList.add("btn-primary");

            });

        });

    </script>
}