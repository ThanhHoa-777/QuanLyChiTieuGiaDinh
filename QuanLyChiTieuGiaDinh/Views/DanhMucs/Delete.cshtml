@model QuanLyChiTieuGiaDinh.Models.DanhMuc

@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-danger">

                <!-- TIÊU ĐỀ -->

                <div class="card-header bg-danger text-white">

                    <h3 class="mb-0">

                        <i class="bi bi-trash"></i>

                        Xóa danh mục

                    </h3>

                </div>


                <div class="card-body">

                    <!-- CẢNH BÁO -->

                    <div class="alert alert-danger">

                        <strong>

                            <i class="bi bi-exclamation-triangle"></i>

                            Bạn có chắc muốn xóa danh mục này không?

                        </strong>

                        <hr />

                        Nếu danh mục đã có giao dịch hoặc đang có
                        danh mục con, hệ thống sẽ
                        <strong>không cho phép xóa</strong>.

                    </div>


                    <!-- PHẠM VI -->
                    @if (Model.MaGiaDinh == null)
                    {
                        <div class="alert alert-secondary">

                            <i class="bi bi-lock"></i>

                            Đây là <strong>danh mục hệ thống</strong>.
                            Danh mục hệ thống không thể xóa.

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">

                            <i class="bi bi-person-check"></i>

                            Chỉ <strong>chủ hộ</strong> mới có quyền
                            xóa danh mục của hộ gia đình.

                        </div>
                    }


                    <!-- BIỂU TƯỢNG + TÊN -->

                    <div class="text-center mb-4">

                        @if (!string.IsNullOrWhiteSpace(Model.BieuTuong))
                        {
                            <div style="font-size: 70px;">
                                @Model.BieuTuong
                            </div>
                        }
                        else
                        {
                            <div style="font-size: 60px;">
                                🏷️
                            </div>
                        }

                        <h3 class="mt-2">
                            @Model.TenDanhMuc
                        </h3>

                    </div>


                    <!-- THÔNG TIN -->

                    <dl class="row">

                        <!-- MÃ -->

                        <dt class="col-sm-5">
                            Mã danh mục
                        </dt>

                        <dd class="col-sm-7">
                            @Model.MaDanhMuc
                        </dd>


                        <!-- TÊN -->

                        <dt class="col-sm-5">
                            Tên danh mục
                        </dt>

                        <dd class="col-sm-7">
                            <strong>
                                @Model.TenDanhMuc
                            </strong>
                        </dd>


                        <!-- LOẠI -->

                        <dt class="col-sm-5">
                            Loại danh mục
                        </dt>

                        <dd class="col-sm-7">

                            @if (Model.LoaiDanhMuc == "ChiTieu")
                            {
                                <span class="badge bg-danger">

                                    <i class="bi bi-arrow-down-circle"></i>

                                    Chi tiêu

                                </span>
                            }
                            else if (Model.LoaiDanhMuc == "ThuNhap")
                            {
                                <span class="badge bg-success">

                                    <i class="bi bi-arrow-up-circle"></i>

                                    Thu nhập

                                </span>
                            }
                            else if (Model.LoaiDanhMuc == "TietKiem")
                            {
                                <span class="badge bg-primary">

                                    <i class="bi bi-piggy-bank"></i>

                                    Tiết kiệm

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @Model.LoaiDanhMuc
                                </span>
                            }

                        </dd>


                        <!-- BIỂU TƯỢNG -->

                        <dt class="col-sm-5">
                            Biểu tượng
                        </dt>

                        <dd class="col-sm-7">

                            @if (!string.IsNullOrWhiteSpace(Model.BieuTuong))
                            {
                                <span style="font-size: 30px;">
                                    @Model.BieuTuong
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Không có
                                </span>
                            }

                        </dd>


                        <!-- PHẠM VI -->

                        <dt class="col-sm-5">
                            Phạm vi
                        </dt>

                        <dd class="col-sm-7">

                            @if (Model.MaGiaDinh == null)
                            {
                                <span class="badge bg-secondary">

                                    <i class="bi bi-globe"></i>

                                    Hệ thống

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary">

                                    <i class="bi bi-people"></i>

                                    Hộ gia đình

                                </span>
                            }

                        </dd>


                        <!-- DANH MỤC CHA -->

                        <dt class="col-sm-5">
                            Danh mục cha
                        </dt>

                        <dd class="col-sm-7">

                            @if (Model.DanhMucCha != null)
                            {
                                <span>

                                    @Model.DanhMucCha.BieuTuong
                                    @Model.DanhMucCha.TenDanhMuc

                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Không có
                                </span>
                            }

                        </dd>

                    </dl>


                    <!-- NÚT XÓA -->
                    @if (Model.MaGiaDinh != null)
                    {
                        <form asp-action="Delete"
                              method="post">

                            <input type="hidden"
                                   asp-for="MaDanhMuc" />

                            <div class="mt-4 d-flex gap-2">

                                <button type="submit"
                                        class="btn btn-danger">

                                    <i class="bi bi-trash"></i>

                                    Xóa danh mục

                                </button>

                                <a asp-action="Details"
                                   asp-route-id="@Model.MaDanhMuc"
                                   class="btn btn-secondary">

                                    <i class="bi bi-arrow-left"></i>

                                    Hủy

                                </a>

                            </div>

                        </form>
                    }
                    else
                    {
                        <div class="mt-4">

                            <span class="btn btn-outline-secondary disabled">

                                <i class="bi bi-lock"></i>

                                Không thể xóa danh mục hệ thống

                            </span>

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>

                                Quay lại

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>