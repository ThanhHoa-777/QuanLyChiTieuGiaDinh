@model QuanLyChiTieuGiaDinh.Models.MucTieuTietKiem

@using QuanLyChiTieuGiaDinh.Models

@{
    ViewData["Title"] = "Chi tiết mục tiêu";

    bool laTruongNhom = ViewBag.LaTruongNhom != null && (bool)ViewBag.LaTruongNhom;
    bool dangChoXacNhan = ViewBag.DangChoXacNhan != null && (bool)ViewBag.DangChoXacNhan;
    int maToi = ViewBag.MaNguoiDungHienTai != null ? (int)ViewBag.MaNguoiDungHienTai : 0;

    decimal tienDo = ViewBag.TienDo != null
        ? Convert.ToDecimal(ViewBag.TienDo) : 0;

    var tienDoCaNhan = ViewBag.TienDoCaNhan as Dictionary<int, decimal>
        ?? new Dictionary<int, decimal>();

    var chuaVaoMucTieu = ViewBag.ChuaVaoMucTieu as List<string> ?? new List<string>();
    var lichSu = ViewBag.LichSu as List<LichSuTietKiem> ?? new List<LichSuTietKiem>();
    int tongSoGiaoDich = ViewBag.TongSoGiaoDich != null ? (int)ViewBag.TongSoGiaoDich : 0;

    bool laNhomTuDo = Model.LoaiMucTieu == LoaiMucTieuTietKiem.NhomTuDo;
    bool laHoGiaDinh = Model.LoaiMucTieu == LoaiMucTieuTietKiem.HoGiaDinh;

    string tenLoai = Model.LoaiMucTieu switch
    {
        LoaiMucTieuTietKiem.CaNhan => "Cá nhân",
        LoaiMucTieuTietKiem.HoGiaDinh => "Hộ gia đình",
        LoaiMucTieuTietKiem.NhomTuDo => "Nhóm tự do",
        _ => Model.LoaiMucTieu.ToString()
    };

    string tenTrangThai = Model.TrangThai switch
    {
        TrangThaiMucTieu.DangTichLuy => "Đang tích lũy",
        TrangThaiMucTieu.DangChiTieu => "Đang chi tiêu",
        TrangThaiMucTieu.DaHoanThanh => "Đã hoàn thành",
        TrangThaiMucTieu.DaHuy => "Đã hủy",
        _ => Model.TrangThai.ToString()
    };

    bool daKetThuc =
        Model.TrangThai == TrangThaiMucTieu.DaHoanThanh ||
        Model.TrangThai == TrangThaiMucTieu.DaHuy;

    string mauTrangThai = daKetThuc
        ? (Model.TrangThai == TrangThaiMucTieu.DaHoanThanh
            ? "bg-success" : "bg-secondary")
        : "bg-primary";

    // Sắp xếp: trưởng nhóm -> đã tham gia -> chờ xác nhận -> đã từ chối
    var dsThanhVien = (Model.ThanhVienMucTieus ?? new List<ThanhVienMucTieu>())
        .OrderBy(t => t.MaNguoiDung == Model.MaTruongNhom ? 0 : 1)
        .ThenBy(t => t.TrangThai == TrangThaiThamGia.DaThamGia ? 0
                   : t.TrangThai == TrangThaiThamGia.ChoXacNhan ? 1 : 2)
        .ThenBy(t => t.NgayThamGia)
        .ToList();

    int soDaThamGia = dsThanhVien.Count(t => t.TrangThai == TrangThaiThamGia.DaThamGia);
    int soChoXacNhan = dsThanhVien.Count(t => t.TrangThai == TrangThaiThamGia.ChoXacNhan);
    int soTuChoi = dsThanhVien.Count(t => t.TrangThai == TrangThaiThamGia.TuChoi);
}

<div class="container py-4">

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- LỜI MỜI THAM GIA -->
    @if (dangChoXacNhan)
    {
        <div class="alert alert-info border-info shadow-sm mb-4">
            <h5 class="fw-bold">
                <i class="bi bi-envelope-paper"></i>
                Bạn được mời tham gia mục tiêu này
            </h5>

            <p class="mb-3">
                Bạn có thể đồng ý hoặc từ chối lời mời tham gia.
                Khi đồng ý, chỉ tiêu đóng góp của các thành viên sẽ được chia lại.
            </p>

            <div class="d-flex gap-2">
                <form asp-action="DongYThamGia" method="post">
                    <input type="hidden" name="id" value="@Model.MaMucTieu" />
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Đồng ý tham gia
                    </button>
                </form>

                <form asp-action="TuChoiThamGia" method="post"
                      onsubmit="return confirm('Bạn có chắc muốn từ chối lời mời?');">
                    <input type="hidden" name="id" value="@Model.MaMucTieu" />
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle"></i> Từ chối
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- HỘ GIA ĐÌNH CÓ NGƯỜI CHƯA VÀO MỤC TIÊU -->
    @if (laTruongNhom && laHoGiaDinh && !daKetThuc && chuaVaoMucTieu.Count > 0)
    {
        <div class="alert alert-warning border-warning shadow-sm mb-4">
            <div class="fw-bold mb-1">
                <i class="bi bi-person-exclamation"></i>
                Có @chuaVaoMucTieu.Count thành viên trong hộ chưa có trong mục tiêu
            </div>
            <div class="mb-2">
                @foreach (var ten in chuaVaoMucTieu)
                {
                    <span class="badge rounded-pill text-bg-warning me-1">@ten</span>
                }
            </div>
            <form asp-action="DongBoThanhVienHo" method="post"
                  onsubmit="return confirm('Đồng bộ thành viên theo danh sách hộ gia đình hiện tại?');">
                <input type="hidden" name="id" value="@Model.MaMucTieu" />
                <button type="submit" class="btn btn-sm btn-warning">
                    <i class="bi bi-arrow-repeat"></i> Đồng bộ ngay và chia lại chỉ tiêu
                </button>
            </form>
        </div>
    }

    <!-- THÔNG TIN MỤC TIÊU -->
    <div class="card shadow-sm border-success-subtle mb-4">

        <div class="card-header bg-success-subtle d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 text-success-emphasis fw-bold">
                @Model.TenMucTieu
            </h4>

            <span class="badge @mauTrangThai px-3 py-2">
                @tenTrangThai
            </span>
        </div>

        <div class="card-body p-4">

            <div class="row mb-3">

                <!-- THÔNG TIN -->
                <div class="col-md-6">

                    <p class="mb-2">
                        <strong>Loại mục tiêu:</strong>
                        <span class="badge bg-light text-dark border">
                            @tenLoai
                        </span>
                    </p>

                    <p class="mb-2">
                        <strong>Trưởng nhóm:</strong>
                        @(Model.TruongNhom?.HoTen ?? "Chưa xác định")
                    </p>

                    <p class="mb-2">
                        <strong>Gia đình:</strong>
                        @(Model.HoGiaDinh?.TenGiaDinh ?? "Không thuộc hộ gia đình")
                    </p>

                    <p class="mb-2">
                        <strong>Ngày bắt đầu:</strong>
                        @Model.NgayBatDau.ToString("dd/MM/yyyy")
                    </p>

                    <p class="mb-2">
                        <strong>Hạn hoàn thành:</strong>
                        @Model.NgayHan.ToString("dd/MM/yyyy")
                    </p>

                    <p class="mb-0">
                        <strong>Thành viên:</strong>
                        <span class="badge text-bg-success">@soDaThamGia đã tham gia</span>
                        @if (soChoXacNhan > 0)
                        {
                            <span class="badge text-bg-warning">@soChoXacNhan chờ xác nhận</span>
                        }
                        @if (soTuChoi > 0)
                        {
                            <span class="badge text-bg-secondary">@soTuChoi đã từ chối</span>
                        }
                    </p>

                </div>

                <!-- TIẾN ĐỘ TỔNG -->
                <div class="col-md-6 text-md-end mt-3 mt-md-0">

                    <h5 class="text-success fw-bold">
                        Tiến độ tổng tích lũy
                    </h5>

                    <h2 class="fw-bold text-success mb-1">
                        @Model.SoTienHienCo.ToString("N0") ₫

                        <small class="text-muted fs-6">
                            / @Model.SoTienMucTieu.ToString("N0") ₫
                        </small>
                    </h2>

                    <div class="progress mt-2 ms-auto"
                         style="height: 10px; max-width: 300px;">

                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @tienDo.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                        </div>
                    </div>

                    <small class="text-muted">
                        Đạt @tienDo% mục tiêu
                    </small>

                    <p class="small text-muted mt-2 mb-0">
                        Còn thiếu:
                        <strong>
                            @Math.Max(0, Model.SoTienMucTieu - Model.SoTienHienCo).ToString("N0") ₫
                        </strong>
                    </p>

                </div>

            </div>

            <!-- CHỨC NĂNG -->
            <div class="d-flex flex-wrap gap-2 border-top pt-3 mt-3">

                @if (laTruongNhom && !daKetThuc)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.MaMucTieu"
                       class="btn btn-outline-primary">
                        <i class="bi bi-pencil-square"></i> Chỉnh sửa
                    </a>
                }

                @if (laTruongNhom && !daKetThuc && laNhomTuDo)
                {
                    <a href="#moiThanhVien"
                       class="btn btn-success">
                        <i class="bi bi-person-plus"></i> Mời thành viên
                    </a>
                }

                @if (laTruongNhom && !daKetThuc && laHoGiaDinh)
                {
                    <form asp-action="DongBoThanhVienHo"
                          method="post"
                          onsubmit="return confirm('Đồng bộ thành viên theo danh sách hộ gia đình hiện tại?');">

                        <input type="hidden" name="id" value="@Model.MaMucTieu" />

                        <button type="submit" class="btn btn-outline-success">
                            <i class="bi bi-arrow-repeat"></i>
                            Đồng bộ thành viên hộ
                        </button>
                    </form>
                }

                @if (laTruongNhom)
                {
                    <a asp-action="Delete"
                       asp-route-id="@Model.MaMucTieu"
                       class="btn btn-outline-danger">
                        <i class="bi bi-trash"></i> Xóa mục tiêu
                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-light border ms-auto">
                    <i class="bi bi-arrow-left"></i> Trở về danh sách
                </a>

            </div>

        </div>
    </div>

    <!-- MỜI THÀNH VIÊN: CHỈ NHÓM TỰ DO -->
    @if (laTruongNhom && laNhomTuDo && !daKetThuc)
    {
        <div class="card shadow-sm mb-4 border-success-subtle"
             id="moiThanhVien">

            <div class="card-header bg-success-subtle py-3">
                <h5 class="mb-0 fw-bold text-success-emphasis">
                    <i class="bi bi-person-plus"></i>
                    Mời thành viên tham gia
                </h5>
            </div>

            <div class="card-body">

                <form asp-action="ThemThanhVien"
                      method="post">

                    <input type="hidden" name="id"
                           value="@Model.MaMucTieu" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Email thành viên
                        </label>

                        <input type="text"
                               name="email"
                               class="form-control"
                               placeholder="Nhập email, nhiều email cách nhau bằng dấu phẩy"
                               required />

                        <small class="text-muted">
                            Người được mời phải có tài khoản trong hệ thống.
                            Họ cần xác nhận lời mời trước khi được tính chỉ tiêu đóng góp.
                        </small>
                    </div>

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-send"></i> Gửi lời mời
                    </button>

                </form>

            </div>
        </div>
    }

    <!-- TIẾN ĐỘ THÀNH VIÊN -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="fw-bold text-dark mb-0">
            <i class="bi bi-people"></i>
            Tiến độ đóng góp từng thành viên
            <span class="text-muted fs-6">(@dsThanhVien.Count người)</span>
        </h5>

    </div>

    <div class="row g-3">

        @if (dsThanhVien.Any())
        {
            foreach (var tv in dsThanhVien)
            {
                decimal phanTramTv = tienDoCaNhan.ContainsKey(tv.MaThanhVienMucTieu)
                ? tienDoCaNhan[tv.MaThanhVienMucTieu] : 0;

                bool daThamGia = tv.TrangThai == TrangThaiThamGia.DaThamGia;
                bool choXacNhan = tv.TrangThai == TrangThaiThamGia.ChoXacNhan;

                bool laChuNhom = tv.MaNguoiDung == Model.MaTruongNhom;
                bool laToi = tv.MaNguoiDung == maToi;

                string trangThaiThanhVien = daThamGia
                ? "Đã tham gia"
                : choXacNhan ? "Chờ xác nhận" : "Đã từ chối";

                string mauThanhVien = daThamGia
                ? "bg-success"
                : choXacNhan ? "bg-warning text-dark" : "bg-secondary";

                <div class="col-md-6 col-lg-4">

                    <div class="card border border-success-subtle shadow-sm h-100">

                        <div class="card-body p-3">

                            <div class="d-flex justify-content-between align-items-start mb-2 gap-2">

                                <div>
                                    <span class="fw-bold text-dark">
                                        @(tv.NguoiDung?.HoTen ?? "Thành viên")
                                    </span>
                                    @if (laToi)
                                    {
                                        <span class="badge text-bg-info ms-1">Bạn</span>
                                    }
                                    @if (laChuNhom)
                                    {
                                        <span class="badge text-bg-primary ms-1">
                                            <i class="bi bi-star-fill"></i> Trưởng nhóm
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(tv.NguoiDung?.Email))
                                    {
                                        <div class="small text-muted text-break">@tv.NguoiDung!.Email</div>
                                    }
                                </div>

                                <span class="badge @mauThanhVien flex-shrink-0">
                                    @trangThaiThanhVien
                                </span>

                            </div>

                            @if (daThamGia)
                            {
                                <div class="progress mb-2"
                                     style="height: 8px;">

                                    <div class="progress-bar bg-success"
                                         role="progressbar"
                                         style="width: @phanTramTv.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                                    </div>

                                </div>

                                <div class="d-flex justify-content-between small text-muted">

                                    <span>
                                        Đã đóng:
                                        <strong class="text-success">
                                            @tv.SoTienDaDong.ToString("N0") ₫
                                        </strong>
                                    </span>

                                    <span>
                                        Chỉ tiêu:
                                        <strong>
                                            @tv.ChiTieuCanDong.ToString("N0") ₫
                                        </strong>
                                    </span>

                                </div>

                                <div class="mt-2 small text-success">
                                    @if (tv.DaHoanThanhChiTieu)
                                    {
                                        <i class="bi bi-check-circle-fill"></i>
                                        <strong>Đã hoàn thành chỉ tiêu</strong>
                                    }
                                    else
                                    {
                                        <span>Đạt @phanTramTv% chỉ tiêu</span>
                                    }
                                </div>
                            }
                            else if (choXacNhan)
                            {
                                <p class="small text-muted mb-0">
                                    Thành viên đang chờ xác nhận lời mời.
                                    Chỉ tiêu đóng góp sẽ được chia khi đồng ý.
                                </p>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">
                                    Thành viên đã từ chối lời mời tham gia.
                                </p>
                            }

                            <!-- TRƯỞNG NHÓM CÓ QUYỀN XÓA THÀNH VIÊN NHÓM TỰ DO -->
                            @if (laTruongNhom && laNhomTuDo && !daKetThuc && !laChuNhom)
                            {
                                <div class="border-top mt-3 pt-2">

                                    <form asp-action="XoaThanhVien"
                                          method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa thành viên này khỏi mục tiêu?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@Model.MaMucTieu" />

                                        <input type="hidden"
                                               name="maThanhVienMucTieu"
                                               value="@tv.MaThanhVienMucTieu" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger w-100">
                                            <i class="bi bi-person-x"></i>
                                            @(choXacNhan ? "Hủy lời mời" : "Xóa thành viên")
                                        </button>

                                    </form>

                                </div>
                            }

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light border text-muted">
                    Chưa có danh sách thành viên tham gia mục tiêu này.
                </div>
            </div>
        }

    </div>
    <!-- LỊCH SỬ TIẾT KIỆM -->
    <div class="card shadow-sm border-success-subtle mt-4">
        <div class="card-header bg-success-subtle py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-success-emphasis">
                <i class="bi bi-clock-history"></i>
                Lịch sử tiết kiệm
                <span class="text-muted fs-6">(@tongSoGiaoDich giao dịch)</span>
            </h5>
        </div>

        @if (lichSu.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Thời gian</th>
                            <th>Người thực hiện</th>
                            <th>Loại</th>
                            <th>Ví nguồn</th>
                            <th class="text-end">Số tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ls in lichSu)
                        {
                            string tenLoaiGd = ls.LoaiGiaoDich switch
                            {
                                LoaiGiaoDichQuy.NapTien => "Nạp tiền",
                                _ => ls.LoaiGiaoDich.ToString()
                            };

                            <tr>
                                <td class="text-nowrap">@ls.NgayThucHien.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @(ls.NguoiThucHien?.HoTen ?? "Không xác định")
                                    @if (ls.MaNguoiThucHien == maToi)
                                    {
                                        <span class="badge text-bg-info ms-1">Bạn</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@tenLoaiGd</span></td>
                                <td>@(ls.TaiKhoanNguon?.TenTaiKhoan ?? "—")</td>
                                <td class="text-end fw-bold text-success text-nowrap">
                                    + @ls.SoTien.ToString("N0") ₫
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (tongSoGiaoDich > lichSu.Count)
            {
                <div class="card-footer text-muted small text-center">
                    Đang hiển thị @lichSu.Count giao dịch gần nhất.
                </div>
            }
        }
        else
        {
            <div class="card-body text-center text-muted py-4">
                Chưa có giao dịch nạp tiền nào cho mục tiêu này.
            </div>
        }
    </div>

</div>