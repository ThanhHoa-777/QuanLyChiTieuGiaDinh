@{
    ViewData["Title"] = "Mời thành viên"; var mucTieu = ViewBag.MucTieu as QuanLyChiTieuGiaDinh.Models.MucTieuTietKiem;
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-6 mx-auto">
        <div class="card-header bg-success-subtle">
            <h5 class="mb-0 text-success-emphasis">Thêm thành viên vào Nhóm</h5>
        </div>
        <div class="card-body p-4">
            <p class="text-muted mb-4">Mục tiêu: <strong>@mucTieu?.TenMucTieu</strong><br />Hệ thống sẽ tự động chia đều lại số tiền mục tiêu cho tất cả thành viên trong nhóm sau khi bạn thêm mới.</p>

            <form asp-action="MoiThanhVien">
                <input type="hidden" name="MaMucTieu" value="@mucTieu?.MaMucTieu" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Chọn người dùng</label>
                    <select name="MaNguoiDung" class="form-select" asp-items="ViewBag.MaNguoiDung">
                        <option value="">-- Chọn thành viên muốn mời --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Details" asp-route-id="@mucTieu?.MaMucTieu" class="btn btn-light border">Hủy</a>
                    <button type="submit" class="btn btn-success">Mời tham gia</button>
                </div>
            </form>
        </div>
    </div>
</div>