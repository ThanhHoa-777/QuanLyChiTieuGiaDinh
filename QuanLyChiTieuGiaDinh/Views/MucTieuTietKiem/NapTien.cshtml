@model QuanLyChiTieuGiaDinh.Models.LichSuTietKiem

@{
    ViewData["Title"] = "Nạp tiền tiết kiệm";
    var mucTieu = ViewBag.MucTieu as QuanLyChiTieuGiaDinh.Models.MucTieuTietKiem;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-wallet2"></i> Nạp tiền vào quỹ tiết kiệm</h5>
                </div>
                <div class="card-body p-4">
                    @if (mucTieu != null)
                    {
                        <div class="alert alert-light border mb-4">
                            <h6 class="fw-bold text-success">@mucTieu.TenMucTieu</h6>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>Đã tích lũy: <strong>@mucTieu.SoTienHienCo.ToString("N0") ₫</strong></span>
                                <span>Mục tiêu: <strong>@mucTieu.SoTienMucTieu.ToString("N0") ₫</strong></span>
                            </div>
                        </div>
                    }

                    <form asp-action="NapTien">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="MaMucTieu" />

                        <div class="mb-3">
                            <label asp-for="MaTaiKhoanNguon" class="form-label fw-bold">Nguồn tiền (Ví / Tài khoản)</label>
                            <select asp-for="MaTaiKhoanNguon" class="form-select" asp-items="ViewBag.MaTaiKhoanNguon">
                                <option value="">-- Chọn tài khoản nguồn --</option>
                            </select>
                            <span asp-validation-for="MaTaiKhoanNguon" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SoTien" class="form-label fw-bold">Số tiền nạp (VNĐ)</label>
                            <div class="input-group">
                                <input asp-for="SoTien" class="form-control form-control-lg" type="number" min="1000" step="1000" placeholder="0" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="SoTien" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GhiChu" class="form-label fw-bold">Ghi chú / Nội dung</label>
                            <textarea asp-for="GhiChu" class="form-control" rows="2" placeholder="Ví dụ: Nạp tiền thưởng tháng 11..."></textarea>
                            <span asp-validation-for="GhiChu" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.MaMucTieu" class="btn btn-light border">Hủy bỏ</a>
                            <button type="submit" class="btn btn-success px-4">Xác nhận nạp tiền</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}