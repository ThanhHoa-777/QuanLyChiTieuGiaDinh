@model List<DonHangKhachVM>
@{ ViewData["Title"] = "Đơn hàng của tôi - ShopSon"; }
<div class="breadcrumb-trang"><a asp-controller="TrangChu" asp-action="Index">Trang chủ</a> › Đơn hàng của tôi</div>
<div style="max-width:860px;margin:0 auto;">
    <div class="tieude-khu"><div class="nhan-nho">Tài khoản</div><h2>Đơn Hàng Của Tôi</h2></div>
    @if (Model.Count == 0)
    {
        <div style="text-align:center;padding:40px;color:#aaa;">
            <div style="font-size:50px;margin-bottom:12px;">🛒</div>
            <p>Bạn chưa có đơn hàng nào.</p>
            <a asp-controller="SanPham" asp-action="Index" class="btn-mua-ngay" style="display:inline-flex;margin-top:12px;">Mua sắm ngay</a>
        </div>
    }
    @foreach (var vm in Model)
    {
        <partial name="_TheDonHang" model="vm" />
    }
</div>
