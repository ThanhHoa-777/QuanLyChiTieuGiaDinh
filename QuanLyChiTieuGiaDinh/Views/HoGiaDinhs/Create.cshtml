@model QuanLyChiTieuGiaDinh.Models.HoGiaDinh
@{
    ViewData["Title"] = "Tạo hộ gia đình";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-house-add me-2"></i> Tạo hộ gia đình</h4>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="TenGiaDinh" class="form-label fw-semibold">Tên hộ gia đình</label>
                            <input asp-for="TenGiaDinh" class="form-control" maxlength="150" required placeholder="Ví dụ: Gia đình Nguyễn Văn A" />
                            <span asp-validation-for="TenGiaDinh" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info py-2 small">
                            <i class="bi bi-info-circle me-1"></i> Sau khi tạo hộ, tài khoản hiện tại sẽ trở thành <strong>Chủ hộ</strong>. Hệ thống sẽ tự động khởi tạo danh mục <strong>Tiết kiệm</strong> mặc định.
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i> Tạo hộ gia đình</button>
                            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}