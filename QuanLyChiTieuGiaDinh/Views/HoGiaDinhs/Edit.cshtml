@model QuanLyChiTieuGiaDinh.Models.HoGiaDinh
@{
    ViewData["Title"] = "Sửa hộ gia đình";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning py-3">
                    <h4 class="mb-0 text-dark"><i class="bi bi-pencil-square me-2"></i> Sửa hộ gia đình</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-1"></i> <strong>Lưu ý:</strong> Chỉ có <strong>Chủ hộ</strong> mới có quyền thay đổi tên hộ.
                    </div>

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="MaGiaDinh" />

                        <div class="mb-3">
                            <label asp-for="TenGiaDinh" class="form-label fw-semibold">Tên hộ gia đình mới</label>
                            <input asp-for="TenGiaDinh" class="form-control" maxlength="150" required placeholder="Nhập tên hộ gia đình mới" />
                            <span asp-validation-for="TenGiaDinh" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Mã hộ gia đình</label>
                            <input value="@Model.MaGiaDinh" class="form-control bg-light" readonly />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning"><i class="bi bi-check-circle me-1"></i> Lưu thay đổi</button>
                            <a asp-action="Details" asp-route-id="@Model.MaGiaDinh" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}