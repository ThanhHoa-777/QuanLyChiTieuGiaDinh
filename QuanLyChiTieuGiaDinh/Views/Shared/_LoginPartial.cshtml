@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using QuanLyChiTieuGiaDinh.Data

@inject ApplicationDbContext DbContext

<ul class="navbar-nav align-items-lg-center">

    @if (User.Identity?.IsAuthenticated == true)
    {
        var email = User.FindFirstValue(ClaimTypes.Email);

        string hoTen = "Người dùng";

        if (!string.IsNullOrEmpty(email))
        {
            var nguoiDung = await DbContext.NguoiDungs
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Email == email);

            if (nguoiDung != null)
            {
                hoTen = nguoiDung.HoTen;
            }
        }

        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold text-nowrap"
               asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="Quản lý thông tin cá nhân">
                👋 Hello @hoTen!
            </a>
        </li>

        <li class="nav-item">
            <form class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("TrangChinh", "TrangChu")">

                <button type="submit"
                        class="nav-link btn btn-link text-dark fw-semibold text-nowrap">
                    Đăng xuất
                </button>

            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold"
               asp-area="Identity"
               asp-page="/Account/Register">
                Đăng ký
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold"
               asp-area="Identity"
               asp-page="/Account/Login">
                Đăng nhập
            </a>
        </li>
    }

</ul>