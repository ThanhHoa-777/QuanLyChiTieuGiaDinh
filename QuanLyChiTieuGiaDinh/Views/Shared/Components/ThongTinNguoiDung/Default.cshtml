@model Shopson.Components.ThongTinNguoiDungModel
@{
    var nd = Model.NguoiDung;
    bool laAdmin = nd.QuyenHan == HangSo.QuyenQuanTri;
    int tongDiem = nd.TongDiem;
    string hang = nd.HangKhachHang;
    int diemThieu = HangThanhVien.DiemConThieu(tongDiem);
}
<div class="dropdown-user" id="dropdownUser">
    <button class="btn-user-toggle" onclick="toggleDropdown()" style="position:relative;">
        <i class="bi bi-person-circle"></i>
        @* Số tin nhắn / thông báo chưa đọc - hiện giống số trên giỏ hàng *@
        @if (Model.SoTinChuaDoc > 0)
        {
            <span class="so-gio" style="top:-6px;right:auto;left:14px;background:#e74c3c;" title="@Model.SoTinChuaDoc tin nhắn chưa đọc">@(Model.SoTinChuaDoc > 9 ? "9+" : Model.SoTinChuaDoc.ToString())</span>
        }
        @nd.TenNguoiDung
        @if (laAdmin)
        {
            <span class="nhan-thuong" style="background:#d63384;color:white;font-size:10px;padding:1px 6px;border-radius:10px;margin-left:4px;">Admin</span>
        }
        else
        {
            <span class="nhan-thuong" style="background:@HangThanhVien.MauHang(hang);color:white;font-size:10px;padding:1px 6px;border-radius:10px;margin-left:4px;">
                @HangThanhVien.IconHang(hang) @HangThanhVien.TenHang(hang)
            </span>
        }
        <i class="bi bi-chevron-down" style="font-size:11px;"></i>
    </button>
    <div class="dropdown-menu-user" id="dropdownMenu" style="min-width:280px;">
        <a asp-controller="TaiKhoan" asp-action="HoSo"><i class="bi bi-person-lines-fill"></i> Hồ Sơ</a>
        <a asp-controller="DonHang" asp-action="Index"><i class="bi bi-bag-check"></i> Đơn Hàng</a>
        <a asp-controller="TinNhan" asp-action="Index" asp-route-tab="thongbao">
            <i class="bi bi-bell"></i> Thông báo
            @if (Model.SoThongBaoChuaDoc > 0)
            {
                <span class="badge-tin">@Model.SoThongBaoChuaDoc</span>
            }
        </a>
        <a asp-controller="TinNhan" asp-action="Index" asp-route-tab="trochuyen">
            <i class="bi bi-chat-dots"></i> Nhắn tin với shop
            @if (Model.SoTinShopChuaDoc > 0)
            {
                <span class="badge-tin">@Model.SoTinShopChuaDoc</span>
            }
        </a>

        @if (!laAdmin)
        {
            <hr style="margin:4px 0;border-color:#f8d7da;">
            <div style="padding:10px 14px;background:linear-gradient(135deg,#fff0f7,#fce4ec);border-radius:8px;margin:4px 6px;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                    <div style="font-weight:700;font-size:13px;color:#1a0a10;">@HangThanhVien.IconHang(hang) Hạng @HangThanhVien.TenHang(hang)</div>
                    <div style="font-size:13px;font-weight:800;color:#d63384;">@TienIch.DinhDangSo(tongDiem) điểm</div>
                </div>
                <div style="background:#f8d7da;border-radius:6px;height:7px;margin-bottom:5px;">
                    <div style="background:@HangThanhVien.MauHang(hang);height:7px;border-radius:6px;width:@(HangThanhVien.PhanTramTienTrinh(tongDiem))%;"></div>
                </div>
                @if (diemThieu > 0)
                {
                    <div style="font-size:11px;color:#888;">Còn <strong>@TienIch.DinhDangSo(diemThieu)</strong> điểm để lên hạng tiếp theo</div>
                }
                else
                {
                    <div style="font-size:11px;color:#27ae60;font-weight:700;">💎 Đã đạt hạng cao nhất!</div>
                }
                @if (Model.LichSuGanDay.Count > 0)
                {
                    <div style="margin-top:8px;border-top:1px dashed #f8d7da;padding-top:6px;">
                        <div style="font-size:11px;color:#d63384;font-weight:700;margin-bottom:4px;">📋 Điểm cộng gần đây</div>
                        @foreach (var ls in Model.LichSuGanDay)
                        {
                            <div style="display:flex;justify-content:space-between;font-size:11px;color:#555;padding:2px 0;border-bottom:1px solid #fce4ec;">
                                @if (ls.MaDonHang != null)
                                {
                                    <a asp-controller="DonHang" asp-action="ChiTiet" asp-route-id="@ls.MaDonHang" style="padding:0;color:#555;display:inline;" title="Xem đơn hàng">@ls.GhiChu ›</a>
                                }
                                else { <span>@ls.GhiChu</span> }
                                <span style="color:#27ae60;font-weight:700;">+@TienIch.DinhDangSo(ls.SoDiemCong) điểm</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <hr style="margin:4px 0;border-color:#f8d7da;">
            <a href="/QuanTri" style="color:#d63384;font-weight:700;"><i class="bi bi-gear-fill"></i> Quản Trị Admin</a>
        }
        <hr style="margin:4px 0;border-color:#f8d7da;">
        <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" style="margin:0;">
            <button type="submit" style="background:none;border:none;width:100%;text-align:left;padding:10px 14px;color:#e74c3c;cursor:pointer;font:inherit;"><i class="bi bi-box-arrow-right"></i> Đăng Xuất</button>
        </form>
    </div>
</div>
