@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using QuanLyChiTieuGiaDinh.Data

@inject ApplicationDbContext DbContext

@{
    ViewData["Title"] = ViewData["Title"] ?? "Quản lý chi tiêu gia đình";

    // =====================================================
    // XÁC ĐỊNH CHỦ HỘ
    // =====================================================

    bool laChuHo = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        var email = User.FindFirstValue(ClaimTypes.Email);

        if (!string.IsNullOrEmpty(email))
        {
            var nguoiDung =
                await DbContext.NguoiDungs
                    .AsNoTracking()
                    .FirstOrDefaultAsync(x =>
                        x.Email == email);

            if (nguoiDung != null)
            {
                laChuHo =
                    await DbContext.HoGiaDinhs
                        .AsNoTracking()
                        .AnyAsync(x =>
                            x.MaChuHo == nguoiDung.MaNguoiDung);
            }
        }
    }
}

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Quản lý chi tiêu gia đình
    </title>

    <!-- BOOTSTRAP -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS CHUNG -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/QuanLyChiTieuGiaDinh.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    <!-- =====================================================
         NAVBAR
         ===================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">

            <div class="container-fluid px-4">

                <!-- =================================================
                     LOGO
                     ================================================= -->

                <a class="navbar-brand fw-bold text-primary me-4 text-nowrap"
                   asp-controller="TrangChu"
                   asp-action="TrangChinh">

                    💰 Quản lý chi tiêu

                </a>


                <!-- =================================================
                     MOBILE BUTTON
                     ================================================= -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuChinh"
                        aria-controls="menuChinh"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="menuChinh">


                    <!-- =================================================
                         MENU CHÍNH
                         ================================================= -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">


                        <!-- TRANG CHỦ -->

                        <li class="nav-item">

                            <a class="nav-link px-2 text-dark fw-semibold text-nowrap"
                               asp-controller="TrangChu"
                               asp-action="TrangChinh">

                                🏠 Trang chủ

                            </a>

                        </li>


                        <!-- GIAO DỊCH -->

                        <li class="nav-item">

                            <a class="nav-link px-2 text-dark fw-semibold text-nowrap"
                               asp-controller="GiaoDiches"
                               asp-action="Index">

                                💰 Giao dịch

                            </a>

                        </li>


                        <!-- =================================================
                             QUẢN LÝ
                             ================================================= -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle px-2 text-dark fw-semibold text-nowrap"
                               href="#"
                               id="quanLyDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                📂 Quản lý

                            </a>


                            <ul class="dropdown-menu shadow-sm border-0"
                                aria-labelledby="quanLyDropdown">

                                <li>

                                    <a class="dropdown-item py-2"
                                       asp-controller="HoGiaDinhs"
                                       asp-action="Index">

                                        🏠 Hộ gia đình

                                    </a>

                                </li>
                                <li>

                                    <a class="dropdown-item py-2"
                                       asp-controller="TaiKhoanTiens"
                                       asp-action="Index">

                                        💳 Tài khoản tiền

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item py-2"
                                       asp-controller="DanhMucs"
                                       asp-action="Index">

                                        📂 Danh mục

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item py-2"
                                       asp-controller="NganSaches"
                                       asp-action="Index">

                                        📋 Ngân sách

                                    </a>

                                </li>

                            </ul>

                        </li>


                        <!-- =================================================
                             TIẾT KIỆM
                             ================================================= -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle px-2 text-dark fw-semibold text-nowrap"
                               href="#"
                               id="tietKiemDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                💎 Tiết kiệm

                            </a>


                            <ul class="dropdown-menu shadow-sm border-0"
                                aria-labelledby="tietKiemDropdown">

                                <li>

                                    <a class="dropdown-item py-2"
                                       asp-controller="MucTieuTietKiems"
                                       asp-action="Index">

                                        🎯 Mục tiêu tiết kiệm

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item py-2"
                                       asp-controller="LichSuTietKiems"
                                       asp-action="Index">

                                        📜 Lịch sử tiết kiệm

                                    </a>

                                </li>

                            </ul>

                        </li>


                        <!-- =================================================
                             BÁO CÁO
                             ================================================= -->

                        <li class="nav-item">

                            <a class="nav-link px-2 text-dark fw-semibold text-nowrap"
                               asp-controller="BaoCao"
                               asp-action="Index">

                                📊 Báo cáo

                            </a>

                        </li>


                        <!-- =================================================
                             THÔNG BÁO
                             ================================================= -->

                        <li class="nav-item">

                            @await Component.InvokeAsync("ThongBao")

                        </li>


                        <!-- =================================================
                             NHẬT KÝ HỆ THỐNG
                             CHỈ CHỦ HỘ
                             ================================================= -->
                        @if (laChuHo)
                        {
                            <li class="nav-item">

                                <a class="nav-link px-2 text-dark fw-bold text-nowrap"
                                   asp-controller="NhatKyHeThongs"
                                   asp-action="Index">

                                    📜 Nhật ký hệ thống

                                </a>

                            </li>
                        }

                    </ul>


                    <!-- =================================================
                         LOGIN / LOGOUT
                         ================================================= -->

                    <div class="ms-lg-3 text-nowrap">

                        <partial name="_LoginPartial" />

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         NỘI DUNG
         ===================================================== -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="border-top footer text-muted mt-4">

        <div class="container">

            &copy; 2026 - Quản lý chi tiêu gia đình

        </div>

    </footer>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>