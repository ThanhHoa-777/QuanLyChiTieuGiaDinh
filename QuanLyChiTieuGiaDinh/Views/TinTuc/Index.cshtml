@model List<TinTuc>
@{
    ViewData["Title"] = "AI Beauty Advisor - ShopSon";
}
<div class="tieude-khu"><div class="nhan-nho">Trợ lý làm đẹp</div><h2>🤖 AI Beauty Advisor</h2></div>

<div style="max-width:760px;margin:0 auto 40px;background:#fff;border:1.5px solid #e1d5f5;border-radius:16px;overflow:hidden;">
    <div style="background:linear-gradient(90deg,#632dba,#9b59b6);color:#fff;padding:14px 20px;">
        <div style="font-weight:700;">💬 Chat với Beauty AI</div>
        <div style="font-size:12px;opacity:.85;">Hỏi về màu son hợp da, flash sale hôm nay, son theo tầm giá...</div>
    </div>
    <div id="khungAI" style="height:360px;overflow-y:auto;padding:16px;background:#faf7fd;">
        <div class="bong-bot">Chào nàng! Mình là Beauty AI của ShopSon 💄 Nàng muốn tìm màu son như thế nào ạ?</div>
    </div>
    <div id="goiYNhanh" style="display:flex;flex-wrap:wrap;gap:8px;padding:10px 14px 0;">
        @foreach (var goiY in new[] { "Son cho da ngăm", "Son lì bền màu nhất", "Gợi ý son dưới 300K", "Son dưỡng môi tốt nhất", "Flash sale hôm nay có gì?" })
        {
            <button type="button" class="btn-goi-y" onclick="guiGoiY('@goiY')" style="border:1.5px solid #d8c7f0;background:#fff;border-radius:20px;padding:6px 14px;cursor:pointer;font-size:13px;">@goiY</button>
        }
    </div>
    <div style="display:flex;gap:8px;padding:12px;">
        <input id="oCauHoi" placeholder="Nhập câu hỏi của bạn..." style="flex:1;padding:11px;border:1.5px solid #d8c7f0;border-radius:10px;" onkeydown="if(event.key==='Enter')guiTinNhan()" />
        <button id="nutGui" onclick="guiTinNhan()" style="background:#632dba;color:#fff;border:none;border-radius:10px;padding:0 22px;cursor:pointer;font-weight:700;">Gửi</button>
        <button onclick="lamMoiChat()" title="Cuộc trò chuyện mới" style="background:#fff;border:1.5px solid #d8c7f0;border-radius:10px;padding:0 12px;cursor:pointer;">🔄</button>
    </div>
</div>

<div class="tieude-khu"><div class="nhan-nho">Tin tức</div><h2>📰 Tin Tức Làm Đẹp</h2></div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;margin-bottom:30px;">
    @foreach (var tin in Model)
    {
        <a asp-controller="TinTuc" asp-action="ChiTiet" asp-route-id="@tin.MaTinTuc" style="background:#fff;border-radius:14px;padding:18px;text-decoration:none;color:inherit;box-shadow:0 2px 10px rgba(0,0,0,.05);">
            <div style="font-size:12px;color:#aaa;">@(tin.NgayDang.HasValue? tin.NgayDang.Value.ToString("dd/MM/yyyy") : "")</div>
            <div style="font-weight:700;color:#d63384;margin:6px 0;">@tin.TieuDe</div>
            <div style="font-size:13px;color:#666;">@TienIch.CatChuoi(tin.NoiDung, 120)</div>
        </a>
    }
    @if (Model.Count == 0)
    {
        <p style="color:#aaa;">Chưa có tin tức nào.</p>
    }
</div>

<style>
    .bong-bot, .bong-nguoi { max-width:80%; padding:10px 14px; border-radius:14px; margin-bottom:10px; white-space:pre-line; font-size:14px; line-height:1.6; }
    .bong-bot { background:#fff; border:1px solid #e1d5f5; }
    .bong-nguoi { background:#632dba; color:#fff; margin-left:auto; }
</style>

@section Scripts {
    <script>
        var lichSu = [];
        var loiNhac = 'Bạn là Beauty AI Advisor của ShopSon. Hãy tư vấn ngắn gọn, thân thiện, dùng emoji. Danh sách sản phẩm bán chạy: @Html.Raw(System.Net.WebUtility.HtmlEncode((string)ViewBag.DanhSachSanPhamAI).Replace("'", "\\'"))';

        // Hiện câu trả lời: mã hóa ký tự HTML trước (chống chèn mã), rồi đổi **chữ** thành chữ in đậm
        function hienNoiDung(o, noiDung) {
            var an = String(noiDung).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            o.innerHTML = an.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        }
        function themBong(loai, noiDung) {
            var khung = document.getElementById('khungAI');
            var d = document.createElement('div');
            d.className = loai === 'bot' ? 'bong-bot' : 'bong-nguoi';
            hienNoiDung(d, noiDung);
            khung.appendChild(d);
            khung.scrollTop = khung.scrollHeight;
            return d;
        }
        async function guiTinNhan() {
            var o = document.getElementById('oCauHoi');
            var text = o.value.trim();
            if (!text) return;
            o.value = '';
            document.getElementById('goiYNhanh').style.display = 'none';
            themBong('nguoi', text);
            var cho = themBong('bot', '⏳ Đang suy nghĩ...');
            document.getElementById('nutGui').disabled = true;
            try {
                var res = await fetch('/TinTuc/Chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': layMaChongGiaMao() },
                    body: JSON.stringify({ cauHoi: text, loiNhac: loiNhac, lichSu: lichSu })
                });
                var kq = await res.json();
                hienNoiDung(cho, kq.traLoi);
                lichSu.push({ vai: 'user', noiDung: text });
                lichSu.push({ vai: 'model', noiDung: kq.traLoi });
            } catch (e) {
                cho.textContent = 'Xin lỗi, mình đang gặp sự cố kết nối. Nàng thử lại sau nhé! 🙏';
            }
            document.getElementById('nutGui').disabled = false;
            document.getElementById('khungAI').scrollTop = document.getElementById('khungAI').scrollHeight;
        }
        function guiGoiY(text) { document.getElementById('oCauHoi').value = text; guiTinNhan(); }
        function lamMoiChat() {
            lichSu = [];
            document.getElementById('khungAI').innerHTML = '<div class="bong-bot">Chào nàng! Mình là Beauty AI của ShopSon 💄 Nàng muốn tìm màu son như thế nào ạ?</div>';
            document.getElementById('goiYNhanh').style.display = 'flex';
        }
    </script>
}
