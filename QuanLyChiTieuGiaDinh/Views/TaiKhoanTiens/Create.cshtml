@model QuanLyChiTieuGiaDinh.Models.TaiKhoanTien

@{
    ViewData["Title"] = "Thêm tài khoản tiền";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <!-- TIÊU ĐỀ -->
                <div class="card-header bg-primary text-white">

                    <h3 class="mb-0">
                        <i class="bi bi-wallet2"></i>
                        Thêm tài khoản tiền
                    </h3>

                </div>

                <div class="card-body">

                    <!-- THÔNG TIN -->
                    <div class="alert alert-info">

                        <div class="fw-semibold mb-2">
                            <i class="bi bi-info-circle"></i>
                            Thông tin tài khoản
                        </div>

                        <div class="mb-1">
                            Tài khoản sẽ được tự động gán vào
                            <strong>hộ gia đình hiện tại</strong>.
                        </div>

                        <div>
                            Bạn sẽ là <strong>người tạo tài khoản</strong>
                            và là người có quyền sửa hoặc xóa tài khoản này.
                        </div>

                    </div>


                    <form asp-action="Create"
                          method="post">

                        <!-- VALIDATION -->

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <!-- TÊN TÀI KHOẢN -->

                        <div class="mb-3">

                            <label asp-for="TenTaiKhoan"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="TenTaiKhoan"
                                   class="form-control"
                                   placeholder="Ví dụ: Tiền mặt gia đình, Ví cá nhân..." />

                            <span asp-validation-for="TenTaiKhoan"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PHẠM VI TÀI KHOẢN -->

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Phạm vi tài khoản
                            </label>

                            <div class="row g-3">

                                <!-- CÁ NHÂN -->

                                <div class="col-md-6">

                                    <div class="card h-100 border">

                                        <div class="card-body">

                                            <div class="form-check">

                                                <input asp-for="LaTaiKhoanGiaDinh"
                                                       class="form-check-input"
                                                       value="false"
                                                       id="taiKhoanCaNhan" />

                                                <label class="form-check-label fw-bold"
                                                       for="taiKhoanCaNhan">

                                                    👤 Tài khoản cá nhân

                                                </label>

                                            </div>

                                            <div class="small text-muted mt-2">

                                                Chỉ bạn có thể xem,
                                                sử dụng, sửa và xóa
                                                tài khoản này.

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- GIA ĐÌNH -->

                                <div class="col-md-6">

                                    <div class="card h-100 border">

                                        <div class="card-body">

                                            <div class="form-check">

                                                <input type="radio"
                                                       name="LaTaiKhoanGiaDinh"
                                                       value="true"
                                                       class="form-check-input"
                                                       id="taiKhoanGiaDinh" />

                                                <label class="form-check-label fw-bold"
                                                       for="taiKhoanGiaDinh">

                                                    🏠 Tài khoản gia đình

                                                </label>

                                            </div>

                                            <div class="small text-muted mt-2">

                                                Tất cả thành viên trong gia đình
                                                đều có thể xem và sử dụng
                                                tài khoản này.

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <div class="form-text mt-2">
                                💡 Tài khoản gia đình phù hợp với tiền chung
                                mà các thành viên cùng đóng góp và sử dụng.
                            </div>

                        </div>


                        <!-- LOẠI TÀI KHOẢN -->

                        <div class="mb-3">

                            <label asp-for="LoaiTaiKhoan"
                                   class="form-label fw-bold">
                            </label>

                            <select asp-for="LoaiTaiKhoan"
                                    class="form-select">

                                <option value="TienMat">
                                    💵 Tiền mặt
                                </option>

                                <option value="NganHang">
                                    🏦 Ngân hàng
                                </option>

                                <option value="ViDienTu">
                                    📱 Ví điện tử
                                </option>

                            </select>

                            <span asp-validation-for="LoaiTaiKhoan"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- SỐ DƯ BAN ĐẦU -->

                        <div class="mb-3">

                            <label asp-for="SoDuBanDau"
                                   class="form-label fw-bold">
                            </label>

                            <div class="input-group">

                                <input asp-for="SoDuBanDau"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       placeholder="0" />

                                <span class="input-group-text">
                                    ₫
                                </span>

                            </div>

                            <div class="form-text">
                                Số dư hiện tại sẽ được tự động đặt bằng
                                số dư ban đầu.
                            </div>

                            <span asp-validation-for="SoDuBanDau"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- GHI CHÚ -->

                        <div class="mb-4">

                            <label asp-for="GhiChu"
                                   class="form-label fw-bold">
                            </label>

                            <textarea asp-for="GhiChu"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Nhập ghi chú nếu có..."></textarea>

                            <span asp-validation-for="GhiChu"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- NÚT -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-plus-circle"></i>
                                Thêm tài khoản

                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Quay lại

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}