@model QuanLyChiTieuGiaDinh.Models.TaiKhoanTien

@{
    ViewData["Title"] = "Thêm tài khoản tiền";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-wallet2"></i>
                        Thêm tài khoản tiền
                    </h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-info">

                        <div class="fw-bold mb-2">
                            <i class="bi bi-info-circle"></i>
                            Thông tin tài khoản
                        </div>

                        <p class="mb-1">
                            Hệ thống chỉ hỗ trợ tạo
                            <strong>Ví cá nhân</strong>.
                        </p>

                        <p class="mb-0">
                            Ví được tự động gán cho bạn và hộ gia đình
                            hiện tại. Số dư ban đầu mặc định là
                            <strong>0đ</strong>.
                        </p>

                    </div>

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <!-- TÊN TÀI KHOẢN -->

                        <div class="mb-3">

                            <label asp-for="TenTaiKhoan"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="TenTaiKhoan"
                                   class="form-control"
                                   placeholder="Ví dụ: Tiền mặt, Tài khoản ngân hàng..." />

                            <span asp-validation-for="TenTaiKhoan"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- LOẠI TÀI KHOẢN -->

                        <div class="mb-3">

                            <label asp-for="LoaiTaiKhoan"
                                   class="form-label fw-bold">
                            </label>

                            <select asp-for="LoaiTaiKhoan"
                                    class="form-select">

                                <option value="TienMat">
                                    💵 Tiền mặt
                                </option>

                                <option value="NganHang">
                                    🏦 Ngân hàng
                                </option>

                                <option value="ViDienTu">
                                    📱 Ví điện tử
                                </option>

                            </select>

                            <span asp-validation-for="LoaiTaiKhoan"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- SỐ DƯ BAN ĐẦU -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Số dư ban đầu
                            </label>

                            <div class="form-control bg-light">
                                0 ₫
                            </div>

                            <div class="form-text">
                                Số dư ban đầu được hệ thống tự động
                                thiết lập bằng 0 và không thể thay đổi.
                            </div>

                        </div>

                        <!-- GHI CHÚ -->

                        <div class="mb-4">

                            <label asp-for="GhiChu"
                                   class="form-label fw-bold">
                            </label>

                            <textarea asp-for="GhiChu"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Nhập ghi chú nếu có..."></textarea>

                            <span asp-validation-for="GhiChu"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- THÔNG TIN TỰ ĐỘNG -->

                        <div class="card bg-light border-0 mb-4">

                            <div class="card-body">

                                <div class="fw-bold mb-3">
                                    <i class="bi bi-shield-check"></i>
                                    Thông tin tự động
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Loại ví:</span>
                                    <strong class="text-primary">
                                        Ví cá nhân
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Chủ sở hữu:</span>
                                    <strong>
                                        Bạn
                                    </strong>
                                </div>

                                <div class="d-flex justify-content-between">
                                    <span>Trạng thái:</span>
                                    <span class="badge bg-success">
                                        Hoạt động
                                    </span>
                                </div>

                            </div>

                        </div>

                        <!-- NÚT -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-plus-circle"></i>
                                Thêm tài khoản

                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Quay lại

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}
