@model QuanLyChiTieuGiaDinh.Models.TaiKhoanTien

@{
    ViewData["Title"] = "Sửa tài khoản tiền";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <!-- TIÊU ĐỀ -->
                <div class="card-header bg-warning">
                    <h3 class="mb-0">
                        <i class="bi bi-pencil-square"></i>
                        Sửa tài khoản tiền
                    </h3>
                </div>

                <div class="card-body">

                   

                    <form asp-action="Edit" method="post">

                        <!-- VALIDATION -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <!-- MÃ TÀI KHOẢN -->
                        <input type="hidden" asp-for="MaTaiKhoan" />

                        <!-- TÊN TÀI KHOẢN -->
                        <div class="mb-3">
                            <label asp-for="TenTaiKhoan"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="TenTaiKhoan"
                                   class="form-control"
                                   placeholder="Nhập tên tài khoản..." />

                            <span asp-validation-for="TenTaiKhoan"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- LOẠI TÀI KHOẢN -->
                        <div class="mb-3">
                            <label asp-for="LoaiTaiKhoan"
                                   class="form-label fw-bold">
                            </label>

                            <select asp-for="LoaiTaiKhoan"
                                    class="form-select">

                                <option value="TienMat">
                                    💵 Tiền mặt
                                </option>

                                <option value="NganHang">
                                    🏦 Ngân hàng
                                </option>

                                <option value="ViDienTu">
                                    📱 Ví điện tử
                                </option>

                            </select>

                            <span asp-validation-for="LoaiTaiKhoan"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- SỐ DƯ BAN ĐẦU -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Số dư ban đầu
                            </label>

                            <div class="input-group">
                                <input class="form-control"
                                       value="@Model.SoDuBanDau.ToString("N0")"
                                       readonly />

                                <span class="input-group-text">₫</span>
                            </div>

                            <div class="form-text">
                                Số dư ban đầu không thể thay đổi sau khi tạo tài khoản.
                            </div>
                        </div>

                        <!-- SỐ DƯ HIỆN TẠI -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Số dư hiện tại
                            </label>

                            <div class="input-group">
                                <input class="form-control"
                                       value="@Model.SoDuHienTai.ToString("N0")"
                                       readonly />

                                <span class="input-group-text">₫</span>
                            </div>

                            <div class="form-text">
                                Số dư được hệ thống tự động cập nhật theo các giao dịch.
                            </div>
                        </div>

                        <!-- GHI CHÚ -->
                        <div class="mb-3">
                            <label asp-for="GhiChu"
                                   class="form-label fw-bold">
                            </label>

                            <textarea asp-for="GhiChu"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Nhập ghi chú nếu có..."></textarea>

                            <span asp-validation-for="GhiChu"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- TRẠNG THÁI -->
                        <div class="mb-4">
                            <div class="form-check">
                                <input asp-for="TrangThai"
                                       class="form-check-input" />

                                <label asp-for="TrangThai"
                                       class="form-check-label fw-bold">
                                    Tài khoản đang hoạt động
                                </label>
                            </div>

                            <div class="form-text">
                                Bỏ chọn nếu muốn khóa tài khoản.
                            </div>
                        </div>

                        <!-- NÚT -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-warning">
                                <i class="bi bi-save"></i>
                                Lưu thay đổi
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i>
                                Quay lại
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
