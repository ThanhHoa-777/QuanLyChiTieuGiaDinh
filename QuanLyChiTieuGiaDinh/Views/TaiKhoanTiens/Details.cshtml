@model QuanLyChiTieuGiaDinh.Models.TaiKhoanTien

@{
    ViewData["Title"] = "Chi tiết tài khoản tiền";

    bool coQuyenSuaXoa = ViewBag.CoQuyenSuaXoa ?? false;
    int maNguoiDung = ViewBag.MaNguoiDung ?? 0;
    bool laTaiKhoanCuaToi = Model.MaNguoiSoHuu == maNguoiDung;
    
    // Biến cho tính năng quỹ chung
    bool laTaiKhoanGiaDinh = Model.LaTaiKhoanGiaDinh || Model.LoaiVi == "QuyChung";
    bool laChuHo = ViewBag.LaChuHo ?? false;

    // Lấy dữ liệu từ ViewBag
    var danhSachGiaoDich = ViewBag.DanhSachGiaoDich as List<QuanLyChiTieuGiaDinh.Models.GiaoDich> ?? new List<QuanLyChiTieuGiaDinh.Models.GiaoDich>();
    var danhSachHanMuc = ViewBag.DanhSachHanMuc as List<QuanLyChiTieuGiaDinh.Models.HanMucChiTieu> ?? new List<QuanLyChiTieuGiaDinh.Models.HanMucChiTieu>();
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12">

            <!-- THÔNG BÁO HẠN MỨC (NẾU CÓ) -->
            @if (ViewBag.ThongBaoHanMuc != null)
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> 
                    <strong>Thông báo:</strong> @ViewBag.ThongBaoHanMuc
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- 3 Ô THÔNG TIN NẰM NGANG -->
            <div class="row g-3 mb-4">
                <!-- Ô 1: TÊN TÀI KHOẢN -->
                <div class="col-12 col-md-4">
                    <div class="card shadow-sm border-0 rounded-4 h-100">
                        <div class="card-body d-flex flex-column justify-content-between p-3 p-md-4">
                            <div class="text-secondary mb-3">Tên tài khoản</div>
                            <div class="d-flex justify-content-between align-items-end">
                                <div class="fs-5 fw-bold text-dark text-truncate" title="@Model.TenTaiKhoan" style="max-width: 80%;">
                                    @Model.TenTaiKhoan
                                </div>
                                <div class="fs-1 lh-1">
                                    @if (Model.LoaiTaiKhoan == "TienMat") { <text>💵</text> }
                                    else if (Model.LoaiTaiKhoan == "NganHang") { <text>🏦</text> }
                                    else if (Model.LoaiTaiKhoan == "ViDienTu") { <text>📱</text> }
                                    else { <text>💳</text> }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ô 2: SỐ DƯ HIỆN TẠI -->
                <div class="col-12 col-md-4">
                    <div class="card shadow-sm border-0 rounded-4 h-100">
                        <div class="card-body d-flex flex-column justify-content-between p-3 p-md-4">
                            <div class="text-secondary mb-3">Số dư hiện tại</div>
                            <div class="d-flex justify-content-between align-items-end">
                                <div class="fs-3 fw-bold text-success">
                                    @Model.SoDuHienTai.ToString("N0")<span class="fs-5 text-muted fw-normal ms-1">₫</span>
                                </div>
                                <div class="fs-1 lh-1">💰</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ô 3: NGƯỜI TẠO -->
                <div class="col-12 col-md-4">
                    <div class="card shadow-sm border-0 rounded-4 h-100">
                        <div class="card-body d-flex flex-column justify-content-between p-3 p-md-4">
                            <div class="text-secondary mb-3">Người tạo</div>
                            <div class="d-flex justify-content-between align-items-end">
                                <div class="fs-4 fw-bold @(laTaiKhoanCuaToi ? "text-primary" : "text-warning")">
                                    @(laTaiKhoanCuaToi ? "Bạn" : "Thành viên khác")
                                </div>
                                <div class="fs-1 lh-1">
                                    @(laTaiKhoanCuaToi ? "👤" : "👥")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- NÚT ĐIỀU HƯỚNG VÀ CHỨC NĂNG -->
            <div class="d-flex flex-wrap gap-2 mb-4">
                @if (coQuyenSuaXoa)
                {
                    <a asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" class="btn btn-warning px-4 shadow-sm rounded-3">
                        <i class="bi bi-pencil"></i> Sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.MaTaiKhoan" class="btn btn-danger px-4 shadow-sm rounded-3">
                        <i class="bi bi-trash"></i> Xóa
                    </a>
                }
                
                @if (laTaiKhoanGiaDinh)
                {
                    @if (laChuHo)
                    {
                        <!-- Nút mở Modal Cài đặt hạn mức -->
                        <button type="button" class="btn btn-primary px-4 shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#modalCaiDatHanMuc">
                            <i class="bi bi-gear"></i> Cài đặt hạn mức
                        </button>
                    }
                    <!-- Nút mở Modal Yêu cầu hoàn tiền -->
                    <button type="button" class="btn btn-info text-white px-4 shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#modalYeuCauHoanTien">
                        <i class="bi bi-cash-coin"></i> Yêu cầu hoàn tiền
                    </button>
                }

                <a asp-action="Index" class="btn btn-light border px-4 shadow-sm rounded-3 ms-auto">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>

            <!-- KHU VỰC CHIA 2 CỘT (DANH SÁCH HẠN MỨC & LỊCH SỬ GIAO DỊCH) -->
            <div class="row g-4">
                
                <!-- CỘT TRÁI: DANH SÁCH HẠN MỨC (Chỉ hiện nếu là quỹ chung) -->
                @if (laTaiKhoanGiaDinh)
                {
                    <div class="col-12 col-lg-4">
                        <div class="card shadow-sm border-0 rounded-4 h-100">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4">
                                <h5 class="mb-0 text-primary fw-bold">
                                    <i class="bi bi-shield-check me-2"></i> Hạn mức thành viên
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                @if (!danhSachHanMuc.Any())
                                {
                                    <div class="text-center p-5">
                                        <div class="display-4 text-muted opacity-25 mb-3">
                                            <i class="bi bi-journal-x"></i>
                                        </div>
                                        <p class="text-muted small mb-0">Chưa có hạn mức nào được thiết lập.</p>
                                    </div>
                                }
                                else
                                {
                                    <ul class="list-group list-group-flush px-3 pb-3">
                                        @foreach (var hm in danhSachHanMuc)
                                        {
                                            <li class="list-group-item px-0 py-3 border-bottom">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <!-- THÔNG TIN THÀNH VIÊN -->
                                                    <div>
                                                        <div class="fw-bold text-dark mb-1">
                                                            <i class="bi bi-person-circle text-secondary me-1"></i> @(hm.ThanhVien?.HoTen ?? "Thành viên")
                                                        </div>
                                                        <div class="small text-muted">
                                                            Hạn chót: @hm.HanChot.ToString("dd/MM/yyyy")
                                                        </div>
                                                    </div>

                                                    <!-- SỐ TIỀN VÀ NÚT HỦY -->
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="text-end">
                                                            <div class="fw-bold text-primary">@hm.SoTienHanMuc.ToString("N0") <span class="fw-normal small">₫</span></div>
                                                            @if (hm.HanChot.Date <= DateTime.Now.Date)
                                                            {
                                                                <span class="badge bg-danger mt-1">Đã hết hạn</span>
                                                            }
                                                        </div>

                                                        <!-- NÚT VÔ HIỆU HÓA (CHỈ HIỂN THỊ VỚI CHỦ HỘ) -->
                                                        @if (laChuHo)
                                                        {
                                                            <form asp-action="VoHieuHoaHanMuc" asp-controller="TaiKhoanTiens" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn hủy hạn mức này không?');">
                                                                <input type="hidden" name="maHanMuc" value="@hm.MaHanMuc" />
                                                                <input type="hidden" name="maTaiKhoan" value="@Model.MaTaiKhoan" />
                                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Vô hiệu hóa hạn mức">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- CỘT PHẢI: LỊCH SỬ GIAO DỊCH -->
                <div class="col-12 @(laTaiKhoanGiaDinh ? "col-lg-8" : "")">
                    <div class="card shadow-sm border-0 rounded-4 h-100">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 text-success fw-bold">
                                <i class="bi bi-clock-history me-2"></i> Lịch sử giao dịch
                            </h5>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">
                                Tổng: @danhSachGiaoDich.Count giao dịch
                            </span>
                        </div>

                        <div class="card-body p-0">
                            @if (!danhSachGiaoDich.Any())
                            {
                                <div class="text-center p-5">
                                    <div class="display-1 text-muted opacity-25 mb-3">
                                        <i class="bi bi-receipt-cutoff"></i>
                                    </div>
                                    <h6 class="text-muted fw-semibold">Chưa có giao dịch nào</h6>
                                    <p class="text-muted small">Tài khoản này hiện chưa phát sinh khoản thu/chi nào.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive px-3 pb-3">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="text-secondary small" style="background-color: #f8f9fa;">
                                            <tr>
                                                <th class="ps-4 rounded-start-3 border-0 py-3">Thời gian</th>
                                                <th class="border-0 py-3">Loại</th>
                                                <th class="border-0 py-3">Số tiền</th>
                                                <th class="border-0 py-3">Nội dung</th>
                                                <th class="pe-4 text-end rounded-end-3 border-0 py-3">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody class="border-top-0">
                                            @foreach (var gd in danhSachGiaoDich)
                                            {
                                                <tr>
                                                    <td class="ps-4 py-3">
                                                        <div class="fw-medium text-dark">@gd.NgayGiaoDich.ToString("dd/MM/yyyy")</div>
                                                        <div class="small text-muted">@gd.NgayGiaoDich.ToString("HH:mm")</div>
                                                    </td>
                                                    <td>
                                                        @if (gd.LoaiGiaoDich == "Thu")
                                                        {
                                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Thu</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">Chi</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="fw-bold fs-6 @(gd.LoaiGiaoDich == "Thu" ? "text-success" : "text-danger")">
                                                            @(gd.LoaiGiaoDich == "Thu" ? "+" : "-")@gd.SoTien.ToString("N0") <span class="fw-normal small">₫</span>
                                                        </span>
                                                    </td>
                                                    <td style="max-width: 220px;">
                                                        <div class="text-truncate fw-medium text-dark" title="@gd.GhiChu">
                                                            @(string.IsNullOrWhiteSpace(gd.GhiChu) ? "Không có nội dung" : gd.GhiChu)
                                                        </div>
                                                    </td>
                                                    <td class="pe-4 text-end">
                                                        <span class="badge bg-light text-secondary border border-secondary border-opacity-25 rounded-pill px-3">
                                                            @gd.TrangThaiQuyetToan
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- NHÚNG MODALS (GIAO DIỆN FORM POPUP) Ở ĐÂY      -->
<!-- ============================================== -->
@if (laTaiKhoanGiaDinh)
{
    <!-- 1. Modal Cài đặt hạn mức -->
    <div class="modal fade" id="modalCaiDatHanMuc" tabindex="-1" aria-labelledby="modalCaiDatHanMucLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form asp-action="CaiDatHanMuc" asp-controller="TaiKhoanTiens" method="post">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold" id="modalCaiDatHanMucLabel">Cài đặt hạn mức chi tiêu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-3">
                        <input type="hidden" name="maTaiKhoan" value="@Model.MaTaiKhoan" />
                        
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-medium">Chọn thành viên</label>
                            <select name="maThanhVien" class="form-select" required>
                                <option value="">-- Chọn thành viên --</option>
                                @if (ViewBag.DanhSachThanhVien != null)
                                {
                                    foreach (var tv in (List<QuanLyChiTieuGiaDinh.Models.NguoiDung>)ViewBag.DanhSachThanhVien)
                                    {
                                        <option value="@tv.MaNguoiDung">@tv.HoTen - @tv.Email</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-medium">Số tiền hạn mức (VNĐ)</label>
                            <div class="input-group">
                                <input type="number" name="soTienHanMuc" class="form-control" min="0" step="1000" placeholder="0" required />
                                <span class="input-group-text">₫</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-medium">Hạn chót</label>
                            <input type="date" name="hanChot" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary px-4">Lưu hạn mức</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. Modal Yêu cầu hoàn tiền -->
    <div class="modal fade" id="modalYeuCauHoanTien" tabindex="-1" aria-labelledby="modalYeuCauHoanTienLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form asp-action="TaoYeuCauHoanTien" asp-controller="TaiKhoanTiens" method="post">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold text-info" id="modalYeuCauHoanTienLabel">Yêu cầu hoàn tiền</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-3">
                        <div class="alert alert-info bg-opacity-10 border-0 small mb-4">
                            Sử dụng form này khi bạn đã nạp dư tiền vào quỹ chung và muốn xin chủ hộ hoàn lại.
                        </div>
                        
                        <input type="hidden" name="maTaiKhoan" value="@Model.MaTaiKhoan" />
                        
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-medium">Số tiền cần hoàn (VNĐ)</label>
                            <div class="input-group">
                                <input type="number" name="soTien" class="form-control" min="1000" step="1000" placeholder="Nhập số tiền" required />
                                <span class="input-group-text">₫</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-medium">Lý do yêu cầu</label>
                            <textarea name="lyDo" class="form-control" rows="3" placeholder="Ví dụ: Nạp dư tiền ăn tháng này..." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-info text-white px-4">Gửi yêu cầu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}