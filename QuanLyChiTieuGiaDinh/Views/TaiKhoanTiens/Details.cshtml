@using System.Text.RegularExpressions
@using QuanLyChiTieuGiaDinh.Models
@model TaiKhoanTien

@{
    ViewData["Title"] = "Chi tiết tài khoản tiền";

    bool coQuyenSuaXoa = ViewBag.CoQuyenSuaXoa ?? false;
    int maNguoiDung = ViewBag.MaNguoiDung ?? 0;
    bool laTaiKhoanCuaToi = Model.MaNguoiSoHuu == maNguoiDung;
    bool laTaiKhoanGiaDinh = Model.LaTaiKhoanGiaDinh || Model.LoaiVi == "QuyChung";
    bool laChuHo = ViewBag.LaChuHo ?? false;

    var danhSachGiaoDich = ViewBag.DanhSachGiaoDich as List<GiaoDich> ?? new List<GiaoDich>();
    var danhSachHanMuc = ViewBag.DanhSachHanMuc as List<HanMucChiTieu> ?? new List<HanMucChiTieu>();
    var danhSachThanhVien = ViewBag.DanhSachThanhVien as List<NguoiDung> ?? new List<NguoiDung>();

    string bieuTuong = Model.LoaiTaiKhoan switch
    {
        "TienMat" => "💵",
        "NganHang" => "🏦",
        "ViDienTu" => "📱",
        _ => "💳"
    };

    // Bỏ các dấu đánh dấu nội bộ như |NAP_HAN_MUC|, |HM:5|, |CHUYEN_TIEN| khỏi nội dung hiển thị
    string LamSachGhiChu(string? ghiChu) =>
        Regex.Replace(ghiChu ?? "", @"\|[A-Z_]+(:\d+)?\|", "").Trim();

    decimal tongThu = danhSachGiaoDich.Where(x => x.LoaiGiaoDich == "Thu").Sum(x => x.SoTien);
    decimal tongChi = danhSachGiaoDich.Where(x => x.LoaiGiaoDich == "Chi").Sum(x => x.SoTien);

    // Chiều cao chung để 2 khung luôn bằng nhau
    const string chieuCao = "height: 65vh;";
}

<div class="container-fluid px-4 py-4">

    <!-- THÔNG BÁO -->
    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            ✅ @TempData["ThongBao"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            ⚠️ @TempData["Loi"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (ViewBag.ThongBaoHanMuc != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            🔔 <strong>Thông báo:</strong> @ViewBag.ThongBaoHanMuc
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ================= TIÊU ĐỀ + NÚT THAO TÁC ================= -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div class="mb-2">
            <h3 class="mb-0 text-success">@bieuTuong @Model.TenTaiKhoan</h3>
            <small class="text-muted">
                @if (laTaiKhoanGiaDinh)
                {
                    <span class="badge bg-success rounded-pill">🏠 Ví gia đình</span>
                }
                else
                {
                    <span class="badge bg-secondary rounded-pill">👤 Ví cá nhân</span>
                    <span class="ms-1">@(laTaiKhoanCuaToi ? "của bạn" : "của thành viên khác")</span>
                }
            </small>
        </div>
        <div class="mb-2">
            @if (coQuyenSuaXoa)
            {
                <a asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" class="btn btn-outline-warning me-1">✏️ Sửa</a>
                <a asp-action="Delete" asp-route-id="@Model.MaTaiKhoan" class="btn btn-outline-danger me-1">🗑 Xóa</a>
            }
            @if (laTaiKhoanGiaDinh && laChuHo)
            {
                <button type="button" class="btn btn-success me-1" data-bs-toggle="modal" data-bs-target="#modalCaiDatHanMuc">
                    ⚙️ Cài đặt hạn mức
                </button>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại</a>
        </div>
    </div>

    <!-- ================= 3 Ô TỔNG QUAN ================= -->
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="alert alert-success mb-0 h-100">
                <div class="small">💰 Số dư hiện tại</div>
                <div class="fs-4 fw-bold">@Model.SoDuHienTai.ToString("N0") ₫</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="small text-muted">Tổng thu</div>
                    <div class="fs-5 fw-bold text-success">+@tongThu.ToString("N0") ₫</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="small text-muted">Tổng chi</div>
                    <div class="fs-5 fw-bold text-danger">-@tongChi.ToString("N0") ₫</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 2 KHUNG CÙNG CHIỀU CAO, CUỘN RIÊNG ================= -->
    <div class="row g-3">

        <!-- KHUNG TRÁI: HẠN MỨC THÀNH VIÊN (CHỈ VÍ GIA ĐÌNH) -->
        @if (laTaiKhoanGiaDinh)
        {
            <div class="col-xl-4 col-lg-5">
                <div class="card border-0 shadow-sm d-flex flex-column" style="@chieuCao">
                    <div class="card-header alert-success border-0 py-3">
                        <h6 class="mb-0 fw-bold">
                            🛡 Hạn mức thành viên
                            <span class="badge bg-success rounded-pill ms-1">@danhSachHanMuc.Count</span>
                        </h6>
                        <small class="text-muted">Số tiền thành viên đã nạp vào quỹ chung</small>
                    </div>

                    <div class="flex-grow-1 overflow-auto">
                        @if (!danhSachHanMuc.Any())
                        {
                            <div class="text-center text-muted py-5">
                                <div class="fs-2">📋</div>
                                Chưa có hạn mức nào được thiết lập
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var hm in danhSachHanMuc)
                                {
                                    string dauDanh = $"|HM:{hm.MaHanMuc}|";

                                    decimal daNap = danhSachGiaoDich
                                    .Where(g =>
                                    g.MaTaiKhoan == Model.MaTaiKhoan &&
                                    g.MaNguoiThucHien == hm.MaThanhVien &&
                                    g.LoaiGiaoDich == "Thu" &&
                                    g.TrangThai == "HoatDong" &&
                                    g.GhiChu != null &&
                                    g.GhiChu.Contains(dauDanh))
                                    .Sum(g => g.SoTien);

                                    decimal conLai = Math.Max(0, hm.SoTienHanMuc - daNap);
                                    decimal tienDo = hm.SoTienHanMuc > 0 ? Math.Min(100, daNap / hm.SoTienHanMuc * 100) : 0;

                                    bool daHuy = !hm.TrangThai;
                                    bool daHetHan = hm.HanChot.Date < DateTime.Today;
                                    bool daDuHanMuc = daNap >= hm.SoTienHanMuc;

                                    string mauThanh = (daHuy || daHetHan) ? "bg-secondary" : "bg-success";

                                    <li class="list-group-item py-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <div class="fw-semibold">👤 @(hm.ThanhVien?.HoTen ?? "Thành viên")</div>
                                                <small class="text-muted">Hạn chót: @hm.HanChot.ToString("dd/MM/yyyy")</small>
                                            </div>
                                            @if (daHuy)
                                            {
                                                <span class="badge bg-secondary rounded-pill">Đã hủy</span>
                                            }
                                            else if (daHetHan)
                                            {
                                                <span class="badge bg-danger rounded-pill">Hết hạn</span>
                                            }
                                            else if (daDuHanMuc)
                                            {
                                                <span class="badge bg-success rounded-pill">Đã đủ</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success rounded-pill">Đang áp dụng</span>
                                            }
                                        </div>

                                        <div class="d-flex justify-content-between small mb-1">
                                            <span>Đã nạp <strong class="text-success">@daNap.ToString("N0") ₫</strong></span>
                                            <span class="text-muted">/ @hm.SoTienHanMuc.ToString("N0") ₫</span>
                                        </div>

                                        <div class="progress mb-2" style="height: 10px;">
                                            <div class="progress-bar @mauThanh"
                                                 role="progressbar"
                                                 style="width: @tienDo.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center small">
                                            <span class="text-muted">
                                                @tienDo.ToString("0.##")% · còn nạp được
                                                <strong class="@(conLai > 0 && !daHetHan && !daHuy ? "text-success" : "text-danger")">@conLai.ToString("N0") ₫</strong>
                                            </span>

                                            @if (laChuHo && hm.TrangThai)
                                            {
                                                <form asp-action="VoHieuHoaHanMuc" asp-controller="TaiKhoanTiens" method="post" class="m-0"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy hạn mức này không?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maHanMuc" value="@hm.MaHanMuc" />
                                                    <input type="hidden" name="maTaiKhoan" value="@Model.MaTaiKhoan" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                                </form>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- KHUNG PHẢI: LỊCH SỬ GIAO DỊCH -->
        <div class="@(laTaiKhoanGiaDinh ? "col-xl-8 col-lg-7" : "col-12")">
            <div class="card border-0 shadow-sm d-flex flex-column" style="@chieuCao">
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center py-3">
                    <strong class="text-success">🕘 Lịch sử biến động số dư</strong>
                    <span class="badge bg-success rounded-pill">@danhSachGiaoDich.Count giao dịch</span>
                </div>

                <div class="flex-grow-1 overflow-auto">
                    @if (!danhSachGiaoDich.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <div class="fs-2">📭</div>
                            Tài khoản này chưa phát sinh giao dịch nào
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-3 sticky-top table-success">Thời gian</th>
                                    <th class="sticky-top table-success">Nội dung</th>
                                    <th class="sticky-top table-success text-end pe-3">Số tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gd in danhSachGiaoDich)
                                {
                                    bool laThu = gd.LoaiGiaoDich == "Thu";
                                    string ghiChu = LamSachGhiChu(gd.GhiChu);

                                    <tr>
                                        <td class="ps-3 text-nowrap">
                                            <div class="fw-semibold">@gd.NgayGiaoDich.ToString("dd/MM/yyyy")</div>
                                            <small class="text-muted">@gd.NgayGiaoDich.ToString("HH:mm")</small>
                                        </td>

                                        <td>
                                            <div class="fw-semibold">@(gd.DanhMuc?.TenDanhMuc ?? "Chưa có danh mục")</div>
                                            @if (!string.IsNullOrWhiteSpace(ghiChu))
                                            {
                                                <small class="text-muted">@ghiChu</small>
                                            }
                                            @if (gd.NguoiThucHien != null)
                                            {
                                                <div><small class="text-muted">bởi @gd.NguoiThucHien.HoTen</small></div>
                                            }
                                        </td>

                                        <td class="text-end text-nowrap pe-3 fw-bold @(laThu ? "text-success" : "text-danger")">
                                            @(laThu ? "+" : "-")@gd.SoTien.ToString("N0") ₫
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL CÀI ĐẶT HẠN MỨC ================= -->
@if (laTaiKhoanGiaDinh && laChuHo)
{
    <div class="modal fade" id="modalCaiDatHanMuc" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form asp-action="CaiDatHanMuc" asp-controller="TaiKhoanTiens" method="post">
                    <div class="modal-header alert-success border-0">
                        <h5 class="modal-title fw-bold">⚙️ Cài đặt hạn mức nạp quỹ</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="maTaiKhoan" value="@Model.MaTaiKhoan" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Thành viên</label>
                            <select name="maThanhVien" class="form-select" required>
                                <option value="">-- Chọn thành viên --</option>
                                @foreach (var tv in danhSachThanhVien)
                                {
                                    <option value="@tv.MaNguoiDung">@tv.HoTen - @tv.Email</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Số tiền hạn mức</label>
                            <div class="input-group">
                                <input type="number" name="soTienHanMuc" class="form-control" min="0" step="1000" placeholder="0" required />
                                <span class="input-group-text">₫</span>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-semibold">Hạn chót</label>
                            <input type="date" name="hanChot" class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success px-4">Lưu hạn mức</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}