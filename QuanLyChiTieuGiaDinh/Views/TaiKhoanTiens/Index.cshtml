@model IEnumerable<QuanLyChiTieuGiaDinh.Models.TaiKhoanTien>

@{
    ViewData["Title"] = "Quản lý tài khoản tiền";
    int maNguoiDung = ViewBag.MaNguoiDung ?? 0;
}

<div class="container mt-4 mb-5">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="mb-1 text-success fw-bold">
                <i class="bi bi-wallet2 me-2"></i>Tài khoản tiền
            </h2>
            <div class="text-secondary small">
                Quản lý số dư cá nhân và quỹ chung của gia đình
            </div>
        </div>

        <a asp-action="Create" class="btn btn-success px-4 py-2 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm tài khoản
        </a>
    </div>

    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

  

    <!-- DANH SÁCH TÀI KHOẢN (GRID CARDS) -->
    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 text-center p-5">
            <div class="card-body">
                <div class="display-1 text-success opacity-50 mb-3"><i class="bi bi-wallet"></i></div>
                <h5 class="text-success fw-bold">Chưa có tài khoản tiền nào</h5>
                <p class="text-muted">Hãy tạo tài khoản cá nhân hoặc tài khoản gia đình để bắt đầu quản lý chi tiêu.</p>
                <a asp-action="Create" class="btn btn-success mt-2 px-4">Thêm tài khoản ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-success border-opacity-25 rounded-4">
                        <div class="card-body d-flex flex-column p-4">

                            <!-- Header Card -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="fw-bold text-success mb-2 text-truncate" style="max-width: 200px;" title="@item.TenTaiKhoan">
                                        @item.TenTaiKhoan
                                    </h5>
                                    <div class="d-flex gap-1 flex-wrap">
                                        @if (item.LaTaiKhoanGiaDinh)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2">
                                                <i class="bi bi-house-door"></i> Gia đình
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border rounded-pill px-2">
                                                <i class="bi bi-person"></i> Cá nhân
                                            </span>
                                        }

                                        @if (item.MaNguoiSoHuu == maNguoiDung)
                                        {
                                            <span class="badge bg-success rounded-pill px-2">Của tôi</span>
                                        }
                                    </div>
                                </div>

                                <!-- Icon Loại tài khoản -->
                                <div class="fs-2 opacity-75" title="@item.LoaiTaiKhoan">
                                    @if (item.LoaiTaiKhoan == "TienMat")
                                    {
                                        <span>💵</span>
                                    }
                                    else if (item.LoaiTaiKhoan == "NganHang")
                                    {

                                        <span>🏦</span>
                                    }
                                    else if (item.LoaiTaiKhoan == "ViDienTu")
                                    {

                                        <span>📱</span>
                                    }
                                    else
                                    {

                                        <i class="bi bi-credit-card text-success"></i>
                                    }
                                </div>
                            </div>

                            <!-- Số dư -->
                            <div class="mt-3 mb-4">
                                <div class="text-muted small mb-1">Số dư hiện tại</div>
                                <h3 class="fw-bold mb-0 @(item.SoDuHienTai < 0 ? "text-danger" : "text-success")">
                                    @item.SoDuHienTai.ToString("N0") <span class="fs-5 text-muted fw-normal">₫</span>
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                                {
                                    <div class="text-muted small mt-2 text-truncate fst-italic">
                                        <i class="bi bi-journal-text me-1"></i> @item.GhiChu
                                    </div>
                                }
                            </div>

                            <!-- Footer Card (Thao tác) -->
                            <div class="mt-auto pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">

                                <!-- Trạng thái -->
                                <div>
                                    @if (item.TrangThai)
                                    {
                                        <span class="small text-success fw-medium">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="small text-secondary fw-medium">
                                            <i class="bi bi-lock-fill me-1"></i>Đã khóa
                                        </span>
                                    }
                                </div>

                                <!-- Nút thao tác bo góc, đổ bóng, màu nền nổi bật -->
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.MaTaiKhoan" class="btn btn-sm btn-success px-3 rounded-3 shadow-sm">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>

                                    <!-- Chỉ hiển thị Sửa/Xóa/Khóa nếu KHÔNG PHẢI là tài khoản gia đình -->
                                    @if (!item.LaTaiKhoanGiaDinh)
                                    {
                                        if (item.MaNguoiSoHuu == maNguoiDung)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="btn btn-sm btn-warning text-dark px-3 rounded-3 shadow-sm">
                                                <i class="bi bi-pencil"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MaTaiKhoan" class="btn btn-sm btn-danger px-3 rounded-3 shadow-sm">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light border px-3 rounded-3 shadow-sm text-muted" disabled title="Chỉ xem">
                                                <i class="bi bi-shield-lock"></i> Khóa
                                            </button>
                                        }
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>