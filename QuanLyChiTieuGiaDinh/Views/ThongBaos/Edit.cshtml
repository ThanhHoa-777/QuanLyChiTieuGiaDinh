@model QuanLyChiTieuGiaDinh.Models.ThongBao

@{
    ViewData["Title"] = "Sửa thông báo";
}

<div class="container py-4">

    <div class="mb-4">

        <h2>
            <i class="bi bi-pencil-square"></i>
            Sửa thông báo
        </h2>

        <p class="text-muted">
            Cập nhật thông tin thông báo
        </p>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="MaThongBao" />


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="mb-3">

                    <label asp-for="MaNguoiDung"
                           class="form-label">
                    </label>

                    <input asp-for="MaNguoiDung"
                           class="form-control" />

                    <span asp-validation-for="MaNguoiDung"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="TieuDe"
                           class="form-label">
                    </label>

                    <input asp-for="TieuDe"
                           class="form-control" />

                    <span asp-validation-for="TieuDe"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="NoiDung"
                           class="form-label">
                    </label>

                    <textarea asp-for="NoiDung"
                              class="form-control"
                              rows="5">
                    </textarea>

                    <span asp-validation-for="NoiDung"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="LoaiThongBao"
                           class="form-label">
                    </label>

                    <select asp-for="LoaiThongBao"
                            class="form-select">

                        <option value="HeThong">
                            Hệ thống
                        </option>

                        <option value="NganSach">
                            Ngân sách
                        </option>

                        <option value="TietKiem">
                            Tiết kiệm
                        </option>

                        <option value="GiaoDich">
                            Giao dịch
                        </option>

                        <option value="GiaoDichDinhKy">
                            Giao dịch định kỳ
                        </option>

                    </select>

                    <span asp-validation-for="LoaiThongBao"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3 form-check">

                    <input asp-for="DaDoc"
                           class="form-check-input" />

                    <label asp-for="DaDoc"
                           class="form-check-label">
                    </label>

                </div>


                <div class="mb-3">

                    <label asp-for="NgayTao"
                           class="form-label">
                    </label>

                    <input asp-for="NgayTao"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="NgayTao"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại
                    </a>

                    <button type="submit"
                            class="btn btn-warning">
                        <i class="bi bi-save"></i>
                        Lưu thay đổi
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}