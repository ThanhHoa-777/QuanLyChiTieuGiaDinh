@model List<TheSanPhamVM>
@{ ViewData["Title"] = "Flash Sale - ShopSon"; }
<div class="khu-flashsale" style="border-radius:14px;margin-bottom:24px;">
    <div class="flashsale-header">
        <div>
            <span class="flash-icon">⚡</span>
            <span class="flash-title">FLASH SALE</span>
            <span class="flash-sub">Giảm @HangSo.PhanTramFlashMacDinh% — Mỗi sản phẩm tối đa @HangSo.LuotFlashToiDa lượt, mỗi khách mua tối đa @HangSo.FlashToiDaMoiKhach sản phẩm/ngày!</span>
        </div>
        <div class="dem-nguoc">
            <div class="dem-o"><span class="dem-gio">00</span><small>Giờ</small></div><span class="dem-dau">:</span>
            <div class="dem-o"><span class="dem-phut">00</span><small>Phút</small></div><span class="dem-dau">:</span>
            <div class="dem-o"><span class="dem-giay">00</span><small>Giây</small></div>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div style="text-align:center;padding:50px;color:#aaa;"><div style="font-size:50px;">⏰</div><p>Hôm nay chưa có sản phẩm flash sale còn hàng.</p></div>
}
<div class="luoi-sanpham">
    @foreach (var the in Model)
    {
        int daBan = the.LuotBanFlash;
        int phanTramBar = Math.Min(100, daBan * 100 / HangSo.LuotFlashToiDa);
        <div>
            <partial name="_TheSanPham" model="the" />
            <div style="padding:6px 10px 0;">
                <div style="background:#f8d7da;border-radius:8px;height:8px;overflow:hidden;">
                    <div style="background:linear-gradient(90deg,#ff6b35,#e74c3c);height:8px;width:@phanTramBar%;"></div>
                </div>
                <div style="font-size:12px;color:@(the.HetLuotFlash ? "#999" : "#e74c3c");margin-top:4px;text-align:center;">
                    @if (the.HetLuotFlash) { <text>Đã hết lượt flash sale hôm nay</text> }
                    else { <text>Đã bán @daBan/@HangSo.LuotFlashToiDa lượt flash</text> }
                </div>
            </div>
        </div>
    }
</div>
