@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <h3 class="fw-bold text-success mb-3">🔑 @ViewData["Title"]</h3>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <!-- MẬT KHẨU CŨ -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Mật khẩu hiện tại" />
                    <label asp-for="Input.OldPassword" class="form-label">Mật khẩu hiện tại</label>
                    <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                </div>

                <!-- MẬT KHẨU MỚI -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Mật khẩu mới" />
                    <label asp-for="Input.NewPassword" class="form-label">Mật khẩu mới</label>
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>

                <!-- XÁC NHẬN MẬT KHẨU MỚI -->
                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Xác nhận mật khẩu mới" />
                    <label asp-for="Input.ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-bold">
                    🔒 Cập nhật mật khẩu
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}