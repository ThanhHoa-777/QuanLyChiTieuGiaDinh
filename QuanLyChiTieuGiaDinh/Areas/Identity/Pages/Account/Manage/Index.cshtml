@page
@model IndexModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <h3 class="fw-bold text-success mb-3">👤 @ViewData["Title"]</h3>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <!-- TÊN DĂNG NHẬP / EMAIL -->
                <div class="form-floating mb-3">
                    <input asp-for="Username" class="form-control bg-light" placeholder="Tên đăng nhập" disabled />
                    <label asp-for="Username" class="form-label">Tên tài khoản / Email</label>
                </div>

                <!-- SỐ ĐIỆN THOẠI -->
                <div class="form-floating mb-4">
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                    <label asp-for="Input.PhoneNumber" class="form-label">Số điện thoại</label>
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                </div>

                <button id="update-profile-button" type="submit" class="btn btn-success btn-lg w-100 rounded-3 fw-bold">
                    💾 Lưu thay đổi
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}