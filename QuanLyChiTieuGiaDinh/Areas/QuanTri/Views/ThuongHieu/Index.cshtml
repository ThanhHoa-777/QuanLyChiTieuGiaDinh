@model List<ThuongHieu>
@{ ViewData["Title"] = "Thương hiệu"; var dem = (Dictionary<int, int>)ViewBag.SoSanPham; }
<h3 class="mb-3"><i class="bi bi-tags text-pink"></i> Thương Hiệu</h3>
<div class="row g-3">
    <div class="col-lg-8"><div class="card shadow-sm border-0"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Mã</th><th>Tên</th><th>Mô tả</th><th>Số SP</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        @foreach (var t in Model)
        {
            <tr class="@(t.NgungKinhDoanh ? "table-secondary" : "")"><td>@t.MaThuongHieu</td><td class="fw-bold">@t.TenThuongHieu</td><td>@TienIch.CatChuoi(t.MoTa, 60)</td><td>@(dem.GetValueOrDefault(t.MaThuongHieu, 0))</td>
                <td>@if (t.NgungKinhDoanh) { <span class="badge bg-secondary">Đã ẩn</span> } else { <span class="badge bg-success">Đang bán</span> }</td>
                <td class="text-end"><a asp-action="Sua" asp-route-id="@t.MaThuongHieu" class="btn btn-sm btn-outline-secondary">Sửa</a>
                <form asp-action="AnHien" asp-route-id="@t.MaThuongHieu" method="post" class="d-inline" onsubmit="return confirm('@(t.NgungKinhDoanh ? "Hiện lại thương hiệu này?" : "Ẩn thương hiệu này? Mọi sản phẩm của thương hiệu sẽ không hiện với khách.")')"><button class="btn btn-sm btn-outline-warning">@(t.NgungKinhDoanh ? "Hiện" : "Ẩn")</button></form>
                <form asp-action="Xoa" asp-route-id="@t.MaThuongHieu" method="post" class="d-inline" onsubmit="return confirm('Xóa thương hiệu này?')"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>
        }
        </tbody></table></div></div>
    <div class="col-lg-4"><form asp-action="Them" method="post" class="card shadow-sm border-0 p-3">
        <h6 class="fw-bold">➕ Thêm thương hiệu</h6>
        <input name="tenThuongHieu" class="form-control mb-2" placeholder="Tên thương hiệu *" required />
        <textarea name="moTa" class="form-control mb-2" rows="3" placeholder="Mô tả"></textarea>
        <button class="btn btn-pink">Thêm</button></form></div>
</div>
