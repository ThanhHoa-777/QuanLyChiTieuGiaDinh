@using Shopson.Areas.QuanTri.Controllers
@model TongQuanVM
@{ ViewData["Title"] = "Tổng quan"; }
<h3 class="mb-4"><i class="bi bi-house-door text-pink"></i> Tổng Quan Cửa Hàng</h3>
<partial name="_DonCanChuY" model="Model.DonCanChuY" />

@{
    void The(string tieuDe, string giaTri, string icon, string mau, string? duongDan = null)
    {
        <div class="col-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0" style="border-left:5px solid @mau !important;">
                <div class="card-body">
                    @if (duongDan != null) { <a href="@duongDan" class="stretched-link" aria-label="@tieuDe"></a> }
                    <div class="d-flex justify-content-between">
                        <div><div class="text-muted small">@tieuDe</div><div class="fs-4 fw-bold">@giaTri</div></div>
                        <i class="bi @icon fs-2" style="color:@mau;"></i>
                    </div>
                </div>
            </div>
        </div>
    }
}
<div class="row g-3 mb-4">
    @{ The("Sản phẩm", Model.TongSanPham.ToString(), "bi-grid", "#d63384"); }
    @{ The("Thương hiệu", Model.TongThuongHieu.ToString(), "bi-tags", "#8e44ad"); }
    @{ The("Người dùng", Model.TongNguoiDung.ToString(), "bi-people", "#2980b9"); }
    @{ The("Tổng đơn hàng", Model.TongDon.ToString(), "bi-bag-check", "#27ae60"); }
    @{ The("Đơn chờ giao", Model.DonChoGiao.ToString(), "bi-clock", "#f39c12"); }
    @{ The("Đơn hoàn thành", Model.DonHoanThanh.ToString(), "bi-check-circle", "#27ae60"); }
    @{ The("Doanh thu tháng này", TienIch.DinhDangTien(Model.DoanhThuThang), "bi-graph-up", "#d63384", Url.Action("Index", "DoanhThu")); }
    @{ The("Tin nhắn chưa đọc", Model.TinChuaDoc.ToString(), "bi-chat-dots", "#e74c3c"); }
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><a asp-controller="DonHang" asp-action="Index" class="text-decoration-none"><div class="alert alert-warning mb-0">🏦 <strong>@Model.DonChuyenKhoanChoXacNhan</strong> đơn chuyển khoản chờ xác nhận tiền</div></a></div>
    <div class="col-md-4"><a asp-controller="KhieuNai" asp-action="Index" class="text-decoration-none"><div class="alert alert-danger mb-0">📢 <strong>@Model.SoKhieuNai</strong> khiếu nại chưa xử lý xong</div></a></div>
    <div class="col-md-4"><a asp-controller="DoanhThu" asp-action="ChiTiet" class="text-decoration-none"><div class="alert alert-info mb-0">💰 Doanh thu khả dụng: <strong>@TienIch.DinhDangTien(Model.SoDuKhaDung)</strong> — bấm để xem chi tiết</div></a></div>
    <div class="col-md-6"><a asp-controller="CongNo" asp-action="KhachHang" class="text-decoration-none"><div class="alert alert-secondary mb-0">👥 Công nợ khách hàng (CK đã nhận, đơn chưa kết thúc): <strong>@TienIch.DinhDangTien(Model.CongNoKhachHang)</strong> — bấm để xem chi tiết</div></a></div>
    <div class="col-md-6"><a asp-controller="CongNo" asp-action="Index" class="text-decoration-none"><div class="alert alert-secondary mb-0">🚚 Công nợ nhà cung cấp chưa trả: <strong>@TienIch.DinhDangTien(Model.CongNoNcc)</strong></div></a></div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-bold">🕒 Đơn hàng gần đây</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light"><tr><th>Mã</th><th>Khách</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th>Ngày đặt</th><th></th></tr></thead>
            <tbody>
            @foreach (var d in Model.DonGanDay)
            {
                <tr>
                    <td>#@d.MaDonHang</td><td><partial name="_TenKhach" model="d" /></td><td>@TienIch.DinhDangTien(d.TongTien)</td>
                    <td>@(d.PhuongThucThanhToan == HangSo.ThanhToanChuyenKhoan ? "Chuyển khoản" : "COD")</td>
                    <td><span class="badge bg-@DichVuDonHang.MauTrangThaiAdmin(d.TrangThai)">@DichVuDonHang.TenTrangThaiAdmin(d.TrangThai)</span></td>
                    <td>@TienIch.NgayGio(d.NgayDat)</td>
                    <td><a asp-controller="DonHang" asp-action="ChiTiet" asp-route-id="@d.MaDonHang" class="btn btn-sm btn-outline-secondary">Xem</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
