@model List<NguoiDung>
@{
    ViewData["Title"] = "Tích điểm khách hàng";
}
<h3 class="mb-1"><i class="bi bi-star-fill text-pink"></i> Tích Điểm Khách Hàng</h3>
<p class="text-muted small">Cứ 10.000đ tiền hàng = 10 điểm (cộng khi đơn hoàn thành). Mỗi lượt đánh giá sản phẩm (1 sản phẩm trong 1 đơn) được thêm @HangSo.DiemDanhGia điểm. Thường &lt; 2.500 · Bạc ≥ 2.500 · Vàng ≥ 5.000 · Kim Cương ≥ 10.000</p>
<div class="row g-3 mb-3">
    @foreach (var h in new[] { "THUONG", "BAC", "VANG", "KIM_CUONG" })
    {
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <div style="font-size:24px;">@HangThanhVien.IconHang(h)</div>
                <div class="fw-bold" style="color:@HangThanhVien.MauHang(h);">@HangThanhVien.TenHang(h)</div><div>@Model.Count(n => n.HangKhachHang == h) khách</div>
            </div>
        </div>
    }
</div>
<div class="card shadow-sm border-0">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Khách hàng</th><th>Liên hệ</th><th>Hạng</th><th>Tổng điểm</th><th>Còn thiếu để lên hạng</th><th></th></tr></thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.TenNguoiDung</td>
                    <td>@n.Email<div class="small text-muted">@n.SoDienThoai</div></td>
                    <td><span class="badge" style="background:@HangThanhVien.MauHang(n.HangKhachHang);">@HangThanhVien.IconHang(n.HangKhachHang) @HangThanhVien.TenHang(n.HangKhachHang)</span></td>
                    <td class="fw-bold text-pink">@TienIch.DinhDangSo(n.TongDiem)</td>
                    <td>@(HangThanhVien.DiemConThieu(n.TongDiem) > 0 ? TienIch.DinhDangSo(HangThanhVien.DiemConThieu(n.TongDiem)) : "Hạng cao nhất")</td>
                    <td><a asp-action="LichSu" asp-route-id="@n.MaNguoiDung" class="btn btn-sm btn-outline-secondary">Lịch sử</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
