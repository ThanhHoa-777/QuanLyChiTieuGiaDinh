@model List<NhaCungCap>
@{ ViewData["Title"] = "Nhà cung cấp"; }
<h3 class="mb-3"><i class="bi bi-building text-pink"></i> Nhà Cung Cấp</h3>
<div class="row g-3">
    <div class="col-lg-8"><div class="card shadow-sm border-0"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Mã</th><th>Tên</th><th>Điện thoại</th><th>Địa chỉ</th><th></th></tr></thead><tbody>
        @foreach (var n in Model)
        {
            <tr><td>@n.MaNcc</td><td>@n.TenNcc</td><td>@n.DienThoai</td><td>@n.DiaChi</td>
                <td class="text-end">
                    <a asp-controller="Kho" asp-action="Index" asp-route-maNcc="@n.MaNcc" class="btn btn-sm btn-outline-primary">📦 Phiếu nhập</a>
                    <a asp-action="Sua" asp-route-id="@n.MaNcc" class="btn btn-sm btn-outline-secondary">Sửa</a>
                    <form asp-action="Xoa" asp-route-id="@n.MaNcc" method="post" class="d-inline" onsubmit="return confirm('Xóa nhà cung cấp này?')"><button class="btn btn-sm btn-outline-danger">Xóa</button></form>
                </td></tr>
        }
        </tbody></table></div></div>
    <div class="col-lg-4"><form asp-action="Them" method="post" class="card shadow-sm border-0 p-3">
        <h6 class="fw-bold">➕ Thêm nhà cung cấp</h6>
        <input name="tenNcc" class="form-control mb-2" placeholder="Tên nhà cung cấp *" required />
        <input name="dienThoai" class="form-control mb-2" placeholder="Điện thoại" />
        <input name="diaChi" class="form-control mb-2" placeholder="Địa chỉ" />
        <textarea name="ghiChu" class="form-control mb-2" rows="2" placeholder="Ghi chú"></textarea>
        <button class="btn btn-pink">Thêm</button>
    </form></div>
</div>
