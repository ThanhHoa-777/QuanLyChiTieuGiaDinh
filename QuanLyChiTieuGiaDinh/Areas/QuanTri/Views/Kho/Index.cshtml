@model List<NhapKho>
@{
    ViewData["Title"] = "Nhập kho";
    var dsNcc = (List<NhaCungCap>)ViewBag.DanhSachNcc;
    int maNccDangLoc = (int)ViewBag.MaNcc;
    decimal tongTienTatCa = Model.Sum(p => p.TongTien);
    var noTheoPhieu = (Dictionary<int, DongNoPhieu>)ViewBag.NoTheoPhieu;
    decimal tongConNo = noTheoPhieu.Values.Sum(d => d.ConNo);
}
<div class="d-flex justify-content-between mb-3">
    <h3><i class="bi bi-box-arrow-in-left text-pink"></i> Phiếu Nhập Kho</h3>
    <a asp-action="Them" class="btn btn-pink"><i class="bi bi-plus-circle"></i> Tạo phiếu nhập</a>
</div>

@* Lọc theo nhà cung cấp *@
<form method="get" asp-action="Index" class="d-flex gap-2 align-items-center mb-3 khong-in">
    <label class="text-nowrap">Nhà cung cấp:</label>
    <select name="maNcc" class="form-select form-select-sm" style="max-width:280px" onchange="this.form.submit()">
        <option value="0">— Tất cả —</option>
        @foreach (var n in dsNcc)
        {
            <option value="@n.MaNcc" selected="@(n.MaNcc == maNccDangLoc)">@n.TenNcc</option>
        }
    </select>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="alert alert-secondary mb-0">Số phiếu<br><strong class="fs-5">@Model.Count</strong></div></div>
    <div class="col-md-4"><div class="alert alert-info mb-0">Tổng tiền các phiếu<br><strong class="fs-5">@TienIch.DinhDangTien(tongTienTatCa)</strong></div></div>
    <div class="col-md-4"><div class="alert alert-warning mb-0">Còn nợ nhà cung cấp<br><strong class="fs-5">@TienIch.DinhDangTien(tongConNo)</strong></div></div>
</div>

<div class="card shadow-sm border-0"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Phiếu</th><th>Ngày nhập</th><th>Nhà cung cấp</th><th>Sản phẩm trong phiếu</th><th>Số lượng</th><th>Tổng tiền</th><th>Thanh toán</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><a asp-action="ChiTiet" asp-route-id="@p.MaNhapKho" class="fw-bold">#@p.MaNhapKho</a></td>
            <td>@TienIch.NgayGio(p.NgayNhap)</td>
            <td>@(p.MaNccNavigation?.TenNcc ?? "—")</td>
            <td class="small">
                @foreach (var c in p.ChiTietNhapKhos.OrderBy(c => c.MaChiTiet))
                {
                    <div>@(c.MaSanPhamNavigation?.TenSanPham ?? "SP #" + c.MaSanPham) <span class="text-muted">× @c.SoLuong</span></div>
                }
            </td>
            <td>@p.ChiTietNhapKhos.Sum(c => c.SoLuong)</td>
            <td>@TienIch.DinhDangTien(p.TongTien)</td>
            <td>
                @if (p.MaNcc == null) { <span class="badge bg-secondary">Không ghi công nợ</span> }
                else if (noTheoPhieu.TryGetValue(p.MaNhapKho, out var no))
                {
                    <span class="badge bg-@(no.ConNo <= 0 ? "success" : no.DaTra > 0 ? "info text-dark" : "warning text-dark")">@no.TrangThai</span>
                    @if (no.QuaHan) { <div><span class="badge bg-danger mt-1">Quá hạn @no.SoNgayQuaHan ngày</span></div> }
                    else if (no.ConNo > 0) { <div class="small text-muted">còn nợ @TienIch.DinhDangTien(no.ConNo)</div> }
                }
                else { <span class="badge bg-success">Đã thanh toán</span> <div class="small text-muted">trả ngay</div> }
            </td>
            <td><a asp-action="ChiTiet" asp-route-id="@p.MaNhapKho" class="btn btn-sm btn-outline-secondary">🔍 Chi tiết</a></td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">Chưa có phiếu nhập nào.</td></tr> }
    </tbody>
</table></div></div>
