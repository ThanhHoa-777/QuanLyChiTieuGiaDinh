@model List<SanPham>
@{
    ViewData["Title"] = "Tồn kho"; var dangGiu = (Dictionary<int, int>)ViewBag.DangGiu;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-boxes text-pink"></i> Tồn Kho</h3>
    <a asp-action="XuatTonKho" class="btn btn-sm btn-outline-success khong-in">📥 Xuất Excel</a>
</div>
<p class="text-muted small">
    <strong>Tồn kho</strong> = hàng đang nằm trên kệ (chỉ trừ khi bấm Giao hàng). <strong>Đang giữ</strong> = số lượng trong các đơn "Chờ giao".
    <strong>Còn bán được</strong> = tồn kho − đang giữ: đây là số khách nhìn thấy và mua được.
</p>
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th></th><th>Sản phẩm</th><th>Thương hiệu</th><th>Tồn kho</th><th>Đang giữ</th><th>Còn bán được</th><th>Đã bán</th><th>Tình trạng</th></tr></thead>
            <tbody>
                @foreach (var sp in Model)
                {
                    <tr>
                        <td style="width:64px;"><img src="@TienIch.DuongDanAnh(sp.HinhAnh)" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" onerror="this.style.display='none'"></td>
                        <td>@sp.TenSanPham</td>
                        <td>@sp.MaThuongHieuNavigation.TenThuongHieu</td>
                        <td class="fw-bold @(sp.TonKho <= 0 ? "text-danger" : sp.TonKho <= 5 ? "text-warning" : "text-success")">@sp.TonKho</td>
                        @{
                            int giu = dangGiu.GetValueOrDefault(sp.MaSanPham); int conBan = Math.Max(0, sp.TonKho - giu);
                        }
                        <td>@(giu > 0 ? giu.ToString() : "—")</td>
                        <td class="fw-bold">@conBan</td>
                        <td>@sp.DaBan</td>
                        <td>
                            @if (sp.TonKho <= 0)
                            {
                                <span class="badge bg-danger">Hết hàng</span>
                            }
                            else if (sp.TonKho <= 10)
                            {

                                <span class="badge bg-warning text-dark">Sắp hết</span>
                            }
                            else
                            {

                                <span class="badge bg-success">Còn hàng</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
