@model List<TinTuc>
@{ ViewData["Title"] = "Tin tức"; }
<div class="d-flex justify-content-between mb-3"><h3><i class="bi bi-newspaper text-pink"></i> Tin Tức</h3><a asp-action="Them" class="btn btn-pink"><i class="bi bi-plus-square"></i> Thêm tin tức</a></div>
<div class="card shadow-sm border-0"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Mã</th><th>Tiêu đề</th><th>Ngày đăng</th><th></th></tr></thead><tbody>
    @foreach (var t in Model)
    {
        <tr><td>@t.MaTinTuc</td><td>@t.TieuDe<div class="small text-muted">@TienIch.CatChuoi(t.NoiDung, 90)</div></td><td>@(t.NgayDang?.ToString("dd/MM/yyyy"))</td>
            <td class="text-end"><a asp-action="Sua" asp-route-id="@t.MaTinTuc" class="btn btn-sm btn-outline-secondary">Sửa</a>
            <form asp-action="Xoa" asp-route-id="@t.MaTinTuc" method="post" class="d-inline" onsubmit="return confirm('Xóa tin này?')"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>
    }
    </tbody></table></div>
