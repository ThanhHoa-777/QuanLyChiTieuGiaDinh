@model TinTuc
@{ bool laSua = Model.MaTinTuc > 0; ViewData["Title"] = laSua ? "Sửa tin tức" : "Thêm tin tức"; }
<h3 class="mb-3">@(laSua ? "✏ Sửa tin tức" : "➕ Thêm tin tức")</h3>
<form asp-action="@(laSua ? "Sua" : "Them")" asp-route-id="@(laSua ? Model.MaTinTuc : (int?)null)" method="post" class="card shadow-sm border-0 p-4">
    <label class="form-label">Tiêu đề *</label><input name="tieuDe" value="@Model.TieuDe" class="form-control mb-2" required />
    <label class="form-label">Ngày đăng</label><input type="date" name="ngayDang" value="@(Model.NgayDang?.ToString("yyyy-MM-dd"))" class="form-control mb-2" style="max-width:220px;" />
    <label class="form-label">Nội dung</label><textarea name="noiDung" rows="10" class="form-control mb-3">@Model.NoiDung</textarea>
    <div><button class="btn btn-pink px-4">💾 Lưu</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div>
</form>
