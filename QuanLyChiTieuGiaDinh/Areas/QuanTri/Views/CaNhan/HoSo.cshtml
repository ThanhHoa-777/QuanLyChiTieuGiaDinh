@model NguoiDung
@{ ViewData["Title"] = "Hồ sơ cá nhân"; }
<h3 class="mb-3"><i class="bi bi-person-lines-fill text-pink"></i> Hồ Sơ Cá Nhân</h3>
<form asp-action="HoSo" method="post" class="card shadow-sm border-0 p-4" style="max-width:560px;">
    <label class="form-label">Tên đăng nhập</label><input value="@Model.TenDangNhap" class="form-control mb-2" disabled />
    <label class="form-label">Họ và tên</label><input name="tenNguoiDung" value="@Model.TenNguoiDung" class="form-control mb-2" required />
    <label class="form-label">Email</label><input name="email" value="@Model.Email" class="form-control mb-2" />
    <label class="form-label">Số điện thoại</label><input name="soDienThoai" value="@Model.SoDienThoai" class="form-control mb-2" />
    <label class="form-label">Địa chỉ</label><input name="diaChi" value="@Model.DiaChi" class="form-control mb-3" />
    <div><button class="btn btn-pink">Lưu</button> <a asp-action="DoiMatKhau" class="btn btn-outline-secondary">Đổi mật khẩu</a></div>
</form>
