@model List<DonHang>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    string loc = ViewBag.TrangThaiLoc;
    var cacTab = new (string Ma, string Ten)[]
    {
        ("", "Tất cả"), (HangSo.XacNhan, "Chờ giao hàng"), (HangSo.DangGiao, "Đang giao"),
        (HangSo.DaGiaoChoXacNhan, "Đã giao — chờ XN"), (HangSo.HoanThanh, "Hoàn thành"), (HangSo.Huy, "Đã hủy"), (HangSo.GiaoThatBai, "Giao thất bại")
    };
}
<h3 class="mb-3"><i class="bi bi-bag-check text-pink"></i> Quản Lý Đơn Hàng
    @if ((int)ViewBag.SoKhieuNai > 0) { <span class="badge bg-danger ms-2" style="font-size:13px;">📢 @ViewBag.SoKhieuNai khiếu nại</span> }
</h3>
<partial name="_DonCanChuY" model="(List<DonCanChuY>)ViewBag.DonCanChuY" />
<div class="mb-2 khong-in"><a asp-action="XuatExcel" asp-route-tt="@loc" class="btn btn-sm btn-outline-success">📥 Xuất Excel (danh sách đang lọc)</a></div>
<div class="mb-3 d-flex flex-wrap gap-2">
    @foreach (var tab in cacTab)
    {
        <a asp-action="Index" asp-route-tt="@tab.Ma" class="btn btn-sm @(loc == tab.Ma ? "btn-pink" : "btn-outline-secondary")">@tab.Ten</a>
    }
    <a asp-controller="KhieuNai" asp-action="Index" class="btn btn-sm btn-outline-danger">📢 Khiếu nại</a>
</div>
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Mã</th><th>Khách hàng</th><th>SĐT</th><th>Tổng tiền</th><th>Thanh toán</th><th>Trạng thái</th><th>Ngày đặt</th><th></th></tr></thead>
            <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td><strong>#@d.MaDonHang</strong></td>
                    <td><partial name="_TenKhach" model="d" /></td>
                    <td>@d.SoDienThoai</td>
                    <td>@TienIch.DinhDangTien(d.TongTien)</td>
                    <td>
                        @(d.PhuongThucThanhToan == HangSo.ThanhToanChuyenKhoan ? "Chuyển khoản" : "COD")
                        @if (d.PhuongThucThanhToan == HangSo.ThanhToanChuyenKhoan)
                        {
                            <span class="badge bg-@(d.DaNhanTien ? "success" : "secondary")">@(d.DaNhanTien ? "Đã nhận tiền" : "Chưa nhận tiền")</span>
                        }
                    </td>
                    <td>
                        <span class="badge bg-@DichVuDonHang.MauTrangThaiAdmin(d.TrangThai)">@DichVuDonHang.TenTrangThaiAdmin(d.TrangThai)</span>
                        @if (d.DaKhieuNai) { <span class="badge bg-danger">Khiếu nại</span> }
                    </td>
                    <td>@TienIch.NgayGio(d.NgayDat)</td>
                    <td><a asp-action="ChiTiet" asp-route-id="@d.MaDonHang" class="btn btn-sm btn-outline-secondary">Chi tiết</a></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">Không có đơn hàng nào.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
