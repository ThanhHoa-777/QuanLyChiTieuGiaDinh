@using Shopson.Areas.QuanTri.Controllers
@model CongNoNccVM
@{
    ViewData["Title"] = "Công nợ nhà cung cấp";
    ViewData["KhaDung"] = Model.SoDuKhaDung;   // cho form trả nợ (_FormTraNo)
    ViewData["QuayVe"] = 0;
}
<h3 class="mb-3"><i class="bi bi-cash-coin text-pink"></i> Công Nợ Nhà Cung Cấp</h3>
<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="alert alert-danger mb-0">Tổng nợ chưa trả<br><strong class="fs-5">@TienIch.DinhDangTien(Model.TongCongNo)</strong></div></div>
    <div class="col-md-3"><div class="alert alert-success mb-0">Tổng doanh thu<br><strong class="fs-5">@TienIch.DinhDangTien(Model.TongDoanhThu)</strong></div></div>
    <div class="col-md-3"><div class="alert alert-secondary mb-0">Đã chi NCC<br><strong class="fs-5">@TienIch.DinhDangTien(Model.DaChiNcc)</strong></div></div>
    <div class="col-md-3"><div class="alert alert-info mb-0">Doanh thu khả dụng<br><strong class="fs-5">@TienIch.DinhDangTien(Model.SoDuKhaDung)</strong></div></div>
</div>
<p class="text-muted small">Doanh thu khả dụng = tổng doanh thu − đã chi NCC. Hạn trả mỗi phiếu = ngày nhập + @HangSo.SoNgayHanNoNcc ngày.
    Mỗi lần trả ít nhất @HangSo.PhanTramTraToiThieu% nợ gốc của phiếu (hoặc đúng số còn nợ nếu nhỏ hơn).</p>

@* ===== 1. TRẢ MỘT LẦN THEO NHÀ CUNG CẤP ===== *@
<h5 class="mt-3 mb-2">⚡ Trả nhanh theo nhà cung cấp</h5>
<p class="small text-muted mb-2">Nhập một số tiền, hệ thống tự chia vào các phiếu <strong>quá hạn / nhập sớm nhất trước</strong>, trả xong phiếu này mới sang phiếu sau.</p>
<div class="card shadow-sm border-0 mb-4"><div class="table-responsive"><table class="table align-middle mb-0">
    <thead class="table-light"><tr><th>Nhà cung cấp</th><th>Số phiếu nợ</th><th>Quá hạn</th><th>Tổng còn nợ</th><th style="width:360px">Trả</th></tr></thead><tbody>
    @foreach (var n in Model.TheoNcc)
    {
        decimal toiDa = Math.Min(n.ConNo, Model.SoDuKhaDung);
        bool traDuoc = toiDa >= n.MucToiThieu && toiDa > 0;
        <tr>
            <td><a asp-controller="Kho" asp-action="Index" asp-route-maNcc="@n.MaNcc">@n.TenNcc</a></td>
            <td>@n.SoPhieu</td>
            <td>@if (n.SoQuaHan > 0) { <span class="badge bg-danger">@n.SoQuaHan phiếu</span> } else { <span class="text-muted">—</span> }</td>
            <td class="fw-bold text-danger">@TienIch.DinhDangTien(n.ConNo)</td>
            <td>
                <form asp-action="TraNoTheoNcc" asp-route-maNcc="@n.MaNcc" method="post" class="khong-in" onsubmit="return confirm('Trả nợ cho @n.TenNcc với số tiền này?')">
                    <div class="input-group input-group-sm">
                        <input type="number" name="soTien" class="form-control" step="1" placeholder="Số tiền trả" required />
                        <button class="btn btn-success" disabled="@(!traDuoc)">💵 Trả</button>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0" onclick="this.form.soTien.value=@((long)n.ConNo)">Trả hết</button>
                        @if (traDuoc) { <button type="button" class="btn btn-outline-secondary btn-sm py-0" onclick="this.form.soTien.value=@((long)toiDa)">Trả tối đa (@TienIch.DinhDangTien(toiDa))</button> }
                    </div>
                </form>
            </td>
        </tr>
    }
    @if (Model.TheoNcc.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">🎉 Không còn khoản nợ nào.</td></tr> }
    </tbody></table></div></div>

@* ===== 2. TỪNG PHIẾU CÒN NỢ ===== *@
<h5 class="mb-2">📄 Từng phiếu còn nợ</h5>
<div class="card shadow-sm border-0 mb-4"><div class="table-responsive"><table class="table align-middle mb-0">
    <thead class="table-light"><tr><th>Phiếu</th><th>Nhà cung cấp</th><th>Ngày nhập</th><th>Hạn trả</th><th>Nợ gốc</th><th>Đã trả</th><th>Còn nợ</th><th style="width:300px">Trả phiếu này</th></tr></thead><tbody>
    @foreach (var d in Model.NoTheoPhieu)
    {
        <tr class="@(d.QuaHan ? "table-danger" : "")">
            <td><a asp-controller="Kho" asp-action="ChiTiet" asp-route-id="@d.MaNhapKho" class="fw-bold">#@d.MaNhapKho</a></td>
            <td>@d.TenNcc</td>
            <td>@TienIch.NgayThangNam(d.NgayNhap)</td>
            <td>@TienIch.NgayThangNam(d.HanThanhToan)<br>
                @if (d.QuaHan) { <span class="badge bg-danger">Quá hạn @d.SoNgayQuaHan ngày</span> }
                else { <span class="small text-muted">còn @d.SoNgayConLai ngày</span> }</td>
            <td>@TienIch.DinhDangTien(d.NoGoc)</td>
            <td>@TienIch.DinhDangTien(d.DaTra) @if (d.DaTra > 0) { <span class="badge bg-info text-dark">@d.PhanTramDaTra%</span> }</td>
            <td class="fw-bold text-danger">@TienIch.DinhDangTien(d.ConNo)</td>
            <td><partial name="_FormTraNo" model="d" view-data="ViewData" /></td>
        </tr>
    }
    @if (Model.NoTheoPhieu.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">🎉 Không còn khoản nợ nào.</td></tr> }
    </tbody></table></div></div>

@* ===== 3. LỊCH SỬ THANH TOÁN ===== *@
<h5 class="mb-2">✅ Lịch sử thanh toán nhà cung cấp</h5>
<div class="card shadow-sm border-0"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Ngày trả</th><th>Nhà cung cấp</th><th>Phiếu nhập</th><th>Số tiền</th><th>Nội dung</th></tr></thead><tbody>
    @foreach (var c in Model.LichSuThanhToan)
    {
        <tr>
            <td>@TienIch.NgayGio(c.NgayGhi)</td>
            <td>@(c.MaNccNavigation?.TenNcc ?? "—")</td>
            <td>@if (c.MaNhapKho != null) { <a asp-controller="Kho" asp-action="ChiTiet" asp-route-id="@c.MaNhapKho">#@c.MaNhapKho</a> } else { <span>—</span> }</td>
            <td class="fw-bold text-success">@TienIch.DinhDangTien(c.SoTien)</td>
            <td class="small">@c.GhiChu</td>
        </tr>
    }
    @if (Model.LichSuThanhToan.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-3">Chưa trả khoản nợ nào.</td></tr> }
    </tbody></table></div>
