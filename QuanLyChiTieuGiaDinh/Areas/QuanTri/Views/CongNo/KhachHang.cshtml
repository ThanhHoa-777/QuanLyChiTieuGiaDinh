@using Shopson.Areas.QuanTri.Controllers
@model CongNoKhachVM
@{ ViewData["Title"] = "Công nợ khách hàng"; }
<h3 class="mb-1"><i class="bi bi-wallet2 text-pink"></i> Công Nợ Khách Hàng</h3>
<p class="text-muted small">Là số tiền <strong>chuyển khoản shop đã nhận</strong> nhưng đơn hàng <strong>chưa kết thúc</strong> (đang chờ giao, đang giao, đã giao chờ xác nhận, hoặc đã hủy / giao thất bại mà chưa hoàn tiền). Đơn hoàn thành thì tiền trở thành doanh thu và không còn là công nợ.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="alert alert-warning mb-0">Shop đang giữ của khách<br><strong class="fs-4">@TienIch.DinhDangTien(Model.TongDangGiu)</strong><div class="small">@Model.DonDangGiu.Count đơn</div></div></div>
    <div class="col-md-4"><div class="alert alert-success mb-0">Tổng tiền CK đã nhận (sổ ghi)<br><strong class="fs-4">@TienIch.DinhDangTien(Model.TongDaNhan)</strong></div></div>
    <div class="col-md-4"><div class="alert alert-danger mb-0">Tổng đã hoàn lại khách<br><strong class="fs-4">@TienIch.DinhDangTien(Model.TongDaHoan)</strong></div></div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white fw-bold">📌 Đơn đang giữ tiền của khách</div>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Đơn</th><th>Khách</th><th>SĐT</th><th>Số tiền</th><th>Trạng thái</th><th>Cần làm</th><th></th></tr></thead><tbody>
        @foreach (var d in Model.DonDangGiu)
        {
            <tr>
                <td>#@d.MaDonHang</td><td><partial name="_TenKhach" model="d" /></td><td>@d.SoDienThoai</td>
                <td class="fw-bold">@TienIch.DinhDangTien(d.TongTien)</td>
                <td><span class="badge bg-@DichVuDonHang.MauTrangThaiAdmin(d.TrangThai)">@DichVuDonHang.TenTrangThaiAdmin(d.TrangThai)</span></td>
                <td class="small">
                    @if (d.TrangThai == HangSo.Huy) { <span class="text-danger">Đơn đã hủy — cần hoàn tiền cho khách</span> }
                    else if (d.TrangThai == HangSo.GiaoThatBai) { <span class="text-danger">Giao thất bại — cần hoàn tiền cho khách</span> }
                    else if (d.TrangThai == HangSo.DaGiaoChoXacNhan && d.DaKhieuNai) { <span class="text-danger">Có khiếu nại — xử lý hoàn tiền</span> }
                    else { <span class="text-muted">Chờ đơn hoàn thành (tiền sẽ thành doanh thu)</span> }
                </td>
                <td><a asp-controller="DonHang" asp-action="ChiTiet" asp-route-id="@d.MaDonHang" class="btn btn-sm btn-outline-secondary">Xem</a></td>
            </tr>
        }
        @if (Model.DonDangGiu.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">🎉 Shop không đang giữ tiền của khách nào.</td></tr> }
        </tbody></table></div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-bold">📒 Sổ ghi nhận / hoàn tiền</span>
        <div class="d-flex gap-2">
            <a asp-action="KhachHang" class="btn btn-sm @(Model.Loc == "" ? "btn-pink" : "btn-outline-secondary")">Tất cả</a>
            <a asp-action="KhachHang" asp-route-loc="@HangSo.DaNhanTienCK" class="btn btn-sm @(Model.Loc == HangSo.DaNhanTienCK ? "btn-pink" : "btn-outline-secondary")">Nhận tiền</a>
            <a asp-action="KhachHang" asp-route-loc="@HangSo.HoanTienCK" class="btn btn-sm @(Model.Loc == HangSo.HoanTienCK ? "btn-pink" : "btn-outline-secondary")">Hoàn tiền</a>
        </div>
    </div>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Ngày</th><th>Khách</th><th>Đơn</th><th>Loại</th><th class="text-end">Số tiền</th><th>Ghi chú</th></tr></thead><tbody>
        @foreach (var c in Model.SoGhi)
        {
            <tr>
                <td>@TienIch.NgayGio(c.NgayGhi)</td>
                <td>@(c.MaNguoiDungNavigation?.TenNguoiDung ?? "—")</td>
                <td>@if (c.MaDonHang != null) { <a asp-controller="DonHang" asp-action="ChiTiet" asp-route-id="@c.MaDonHang">#@c.MaDonHang</a> } else { <span>—</span> }</td>
                <td>@if (c.LoaiGhiChu == HangSo.HoanTienCK) { <span class="badge bg-danger">Hoàn tiền</span> } else { <span class="badge bg-success">Nhận tiền</span> }</td>
                <td class="text-end fw-bold @(c.SoTien < 0 ? "text-danger" : "text-success")">@(c.SoTien > 0 ? "+" : "")@TienIch.DinhDangTien(c.SoTien)</td>
                <td class="small text-muted">@c.GhiChu</td>
            </tr>
        }
        @if (Model.SoGhi.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có giao dịch nào.</td></tr> }
        </tbody></table></div>
</div>
