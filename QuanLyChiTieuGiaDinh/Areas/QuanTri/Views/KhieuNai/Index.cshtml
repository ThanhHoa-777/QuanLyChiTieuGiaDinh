@model List<DonHang>
@{ ViewData["Title"] = "Khiếu nại"; string xl = ViewBag.XuLy; }
<h3 class="mb-3"><i class="bi bi-exclamation-triangle text-pink"></i> Khiếu Nại Của Khách</h3>
<div class="mb-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-sm @(xl == "" ? "btn-pink" : "btn-outline-secondary")">Tất cả</a>
    <a asp-action="Index" asp-route-xuLy="chua" class="btn btn-sm @(xl == "chua" ? "btn-pink" : "btn-outline-secondary")">Chưa xử lý xong</a>
    <a asp-action="Index" asp-route-xuLy="xong" class="btn btn-sm @(xl == "xong" ? "btn-pink" : "btn-outline-secondary")">Đã xử lý xong</a>
</div>
<div class="card shadow-sm border-0"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Đơn</th><th>Khách</th><th>Nội dung khiếu nại</th><th>Ngày gửi</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td>#@d.MaDonHang</td><td><partial name="_TenKhach" model="d" /><div class="small text-muted">@d.SoDienThoai</div></td>
            <td style="max-width:320px;">@TienIch.CatChuoi(d.NoiDungKhieuNai, 120)
                @if (!string.IsNullOrEmpty(d.AnhKhieuNai)) { <div><a href="@TienIch.DuongDanAnh(d.AnhKhieuNai)" target="_blank"><img src="@TienIch.DuongDanAnh(d.AnhKhieuNai)" style="height:48px;border-radius:6px;" /></a></div> }</td>
            <td>@TienIch.NgayGio(d.NgayKhieuNai)</td>
            <td><span class="badge bg-@DichVuDonHang.MauTrangThaiAdmin(d.TrangThai)">@DichVuDonHang.TenTrangThaiAdmin(d.TrangThai)</span></td>
            <td class="text-nowrap"><a asp-controller="DonHang" asp-action="ChiTiet" asp-route-id="@d.MaDonHang" class="btn btn-sm btn-pink">Xử lý</a>
                @if (d.MaNguoiDung != null) { <a asp-controller="TinNhan" asp-action="HoiThoai" asp-route-id="@d.MaNguoiDung" class="btn btn-sm btn-outline-secondary">💬 Nhắn tin</a> }</td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Không có khiếu nại nào.</td></tr> }
    </tbody>
</table></div></div>
