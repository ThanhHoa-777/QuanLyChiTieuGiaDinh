@model List<MaGiamGium>
@{ ViewData["Title"] = "Mã giảm giá"; var homNay = TienIch.HomNay(); }
<div class="d-flex justify-content-between mb-3">
    <h3><i class="bi bi-ticket-perforated text-pink"></i> Mã Giảm Giá</h3>
    <a asp-action="Them" class="btn btn-pink"><i class="bi bi-plus-circle"></i> Thêm mã</a>
</div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Mã</th><th>Giá trị</th><th>Hạng</th><th>Đơn tối thiểu</th><th>Đã dùng</th><th>Mỗi khách</th><th>Hết hạn</th><th></th></tr></thead><tbody>
    @foreach (var v in Model)
    {
        bool hetHan = v.NgayHetHan != null && v.NgayHetHan < homNay;
        <tr class="@(hetHan ? "table-secondary" : "")">
            <td><strong>@v.MaCode</strong><div class="small text-muted">@v.MoTa</div></td>
            <td>@if (v.GiaTri == 0) { <span>Miễn ship</span> } else if (v.LoaiGiam == "PHAN_TRAM") { <span>@v.GiaTri%@(v.GiamToiDa > 0 ? " (tối đa " + TienIch.DinhDangSo(v.GiamToiDa) + "đ)" : "")</span> } else { <span>@TienIch.DinhDangTien(v.GiaTri)</span> }</td>
            <td><span class="badge" style="background:@HangThanhVien.MauHang(v.HangVoucher);">@HangThanhVien.TenHang(v.HangVoucher)</span></td>
            <td>@(v.DonToiThieu > 0 ? TienIch.DinhDangTien(v.DonToiThieu) : "—")</td>
            <td><a asp-action="DonDaDung" asp-route-id="@v.MaCode" title="Xem các đơn đã dùng mã này">@v.SoLanDung / @v.GioiHanDung</a></td>
            <td>@(v.SoLanMoiKhach == 0 ? "Không giới hạn" : v.SoLanMoiKhach + " lần")</td>
            <td>@(v.NgayHetHan?.ToString("dd/MM/yyyy") ?? "Không giới hạn") @if (hetHan) { <span class="badge bg-danger">Hết hạn</span> }</td>
            <td class="text-end"><a asp-action="Sua" asp-route-id="@v.MaCode" class="btn btn-sm btn-outline-secondary">Sửa</a>
                <form asp-action="Xoa" asp-route-id="@v.MaCode" method="post" class="d-inline" onsubmit="return confirm('Xóa mã này?')"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td>
        </tr>
    }
    </tbody></table></div></div>
