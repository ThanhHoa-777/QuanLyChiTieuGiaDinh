@using Shopson.Areas.QuanTri.Controllers
@model ChiTietDoanhThuVM
@{ ViewData["Title"] = "Chi tiết doanh thu"; }
<h3 class="mb-1"><i class="bi bi-receipt text-pink"></i> Chi Tiết Doanh Thu — @Model.TieuDe</h3>
<p class="text-muted small">Doanh thu = tổng tiền các đơn <strong>Hoàn thành</strong> (tính theo ngày hoàn thành). Doanh thu khả dụng = tổng doanh thu − tiền đã chi nhà cung cấp.</p>

<div class="mb-3 khong-in"><a asp-action="XuatExcel" asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" class="btn btn-sm btn-outline-success">📥 Xuất Excel (khoảng đang xem)</a></div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="alert alert-success mb-0">💰 Doanh thu: <strong>@TienIch.DinhDangTien(Model.TongDoanhThu)</strong> (@Model.DonHang.Count đơn)</div></div>
    <div class="col-md-4"><div class="alert alert-warning mb-0">🚚 Đã chi nhà cung cấp: <strong>@TienIch.DinhDangTien(Model.TongChi)</strong> (@Model.KhoanChi.Count khoản)</div></div>
    <div class="col-md-4"><div class="alert alert-info mb-0">✅ Doanh thu − Chi = <strong>@TienIch.DinhDangTien(Model.TongDoanhThu - Model.TongChi)</strong></div></div>
</div>

<h5>Doanh thu theo sản phẩm</h5>
<div class="card shadow-sm border-0 mb-4"><table class="table table-sm align-middle mb-0">
    <thead class="table-light"><tr><th>Sản phẩm</th><th class="text-end">Số lượng</th><th class="text-end">Tiền hàng</th></tr></thead><tbody>
    @foreach (var sp in Model.SanPham) { <tr><td>@sp.TenSanPham</td><td class="text-end">@sp.SoLuong</td><td class="text-end">@TienIch.DinhDangTien(sp.TienHang)</td></tr> }
    @if (Model.SanPham.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-3">Không có dữ liệu.</td></tr> }
    </tbody></table></div>

<h5>Các đơn hàng hoàn thành</h5>
<div class="card shadow-sm border-0 mb-4"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Mã</th><th>Khách</th><th>Hoàn thành lúc</th><th>Thanh toán</th><th class="text-end">Tổng tiền</th></tr></thead><tbody>
    @foreach (var x in Model.DonHang)
    {
        <tr style="cursor:pointer;" title="Bấm để xem đơn" onclick="location.href='@Url.Action("ChiTiet", "DonHang", new { id = x.Don.MaDonHang })'"><td>#@x.Don.MaDonHang</td><td><partial name="_TenKhach" model="x.Don" /></td><td>@x.NgayTinh.ToString("dd-MM-yyyy HH:mm")</td>
            <td>@(x.Don.PhuongThucThanhToan == HangSo.ThanhToanChuyenKhoan ? "Chuyển khoản" : "COD")</td>
            <td class="text-end fw-bold">@TienIch.DinhDangTien(x.Don.TongTien)</td></tr>
    }
    @if (Model.DonHang.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-3">Không có đơn hoàn thành trong khoảng này.</td></tr> }
    </tbody></table></div></div>

<h5>Các khoản đã chi cho nhà cung cấp</h5>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Ngày</th><th>Phiếu nhập</th><th>Nhà cung cấp</th><th>Ghi chú</th><th class="text-end">Số tiền</th></tr></thead><tbody>
    @foreach (var c in Model.KhoanChi)
    {
        @* Bấm dòng để mở phiếu nhập của khoản chi (xem công nợ và lịch sử trả của phiếu đó) *@
        <tr style="@(c.MaNhapKho != null ? "cursor:pointer;" : "")" title="Bấm để xem phiếu nhập"
            onclick="@(c.MaNhapKho != null ? "location.href='" + Url.Action("ChiTiet", "Kho", new { id = c.MaNhapKho }) + "'" : "")"><td>@c.NgayGhi.ToString("dd-MM-yyyy HH:mm")</td>
            <td>@(c.MaNhapKho != null ? "#" + c.MaNhapKho : "—")</td><td>@(c.MaNccNavigation?.TenNcc ?? "—")</td><td>@c.GhiChu</td><td class="text-end">@TienIch.DinhDangTien(c.SoTien)</td></tr>
    }
    @if (Model.KhoanChi.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-3">Không có khoản chi nào.</td></tr> }
    </tbody></table></div></div>

<h5 class="mt-4">📉 Hàng hao hụt trong kỳ (phiếu điều chỉnh kho) — <span class="text-danger">@TienIch.DinhDangTien(Model.TongHaoHut)</span></h5>
<p class="text-muted small">Chỉ để theo dõi: hàng hỏng / hết hạn / mất tính theo giá vốn. Không trừ vào doanh thu và không đổi công nợ nhà cung cấp.</p>
<div class="card shadow-sm border-0 mb-4"><table class="table table-sm align-middle mb-0">
    <thead class="table-light"><tr><th>Phiếu</th><th>Ngày</th><th>Sản phẩm</th><th>Loại</th><th class="text-end">SL</th><th class="text-end">Giá trị</th><th>Ghi chú</th></tr></thead><tbody>
    @foreach (var d in Model.HaoHut)
    {
        <tr><td>#@d.MaDieuChinh</td><td>@TienIch.NgayGio(d.NgayTao)</td><td>@d.MaSanPhamNavigation.TenSanPham</td><td>@HangSo.TenLoaiDieuChinh(d.LoaiDieuChinh)</td>
            <td class="text-end">@(d.SoLuong > 0 ? "+" : "")@d.SoLuong</td><td class="text-end">@TienIch.DinhDangTien(d.GiaTriHaoHut)</td><td class="small">@d.GhiChu</td></tr>
    }
    @if (Model.HaoHut.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">Không có phiếu điều chỉnh nào trong kỳ.</td></tr> }
</tbody></table></div>
