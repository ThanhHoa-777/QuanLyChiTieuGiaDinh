@model List<TinNhan>
@{ ViewData["Title"] = "Hội thoại"; var k = (NguoiDung)ViewBag.Khach; }
<div class="d-flex justify-content-between mb-3"><h3>💬 @k.TenNguoiDung <small class="text-muted fs-6">(@k.SoDienThoai)</small></h3><a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Danh sách</a></div>
<div class="card shadow-sm border-0" style="max-width:720px;">
    <div id="khung" style="height:400px;overflow-y:auto;padding:16px;background:#fdf6f8;display:flex;flex-direction:column;gap:8px;">
        @foreach (var t in Model)
        {
            <div class="d-flex @(t.LaAdmin ? "justify-content-end" : "justify-content-start")">
                <div class="px-3 py-2 rounded-3" style="max-width:75%;white-space:pre-line;@(t.LaAdmin ? "background:#d63384;color:#fff;" : "background:#fff;border:1px solid #f8d7da;")">
                    @if (!string.IsNullOrEmpty(t.HinhAnh))
                    {
                        <a href="@TienIch.DuongDanAnh(t.HinhAnh)" target="_blank"><img src="@TienIch.DuongDanAnh(t.HinhAnh)" style="max-width:220px;max-height:220px;border-radius:10px;display:block;margin-bottom:4px;" /></a>
                    }
                    @t.NoiDung<div style="font-size:10px;opacity:.7;">@(t.LaAdmin ? "ShopSon" : t.TenNguoiGui) · @t.NgayGui.ToString("dd/MM HH:mm")</div>
                </div>
            </div>
        }
    </div>
    <form asp-action="TraLoi" asp-route-id="@k.MaNguoiDung" method="post" enctype="multipart/form-data" class="d-flex gap-2 p-3 border-top align-items-center">
        <input name="noiDung" class="form-control" placeholder="Nhập câu trả lời..." />
        <input type="file" name="anh" accept="image/*" class="form-control" style="max-width:220px;" title="Gửi kèm ảnh (không bắt buộc)" /><button class="btn btn-pink">Gửi</button>
    </form>
</div>
@section Scripts { <script>var k = document.getElementById('khung'); k.scrollTop = k.scrollHeight;</script> }
