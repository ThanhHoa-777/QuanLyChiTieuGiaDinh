@using Shopson.Areas.QuanTri.Controllers
@model List<CuocTroChuyenVM>
@{ ViewData["Title"] = "Tin nhắn khách"; }
<h3 class="mb-3"><i class="bi bi-chat-dots text-pink"></i> Tin Nhắn Khách Hàng</h3>
<div class="card shadow-sm border-0"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Khách hàng</th><th>Tin gần nhất</th><th>Thời gian</th></tr></thead><tbody>
    @foreach (var c in Model)
    {
        @* Bấm vào bất kỳ chỗ nào trên dòng là mở hội thoại *@
        <tr class="@(c.SoChuaDoc > 0 ? "table-warning" : "")" style="cursor:pointer;" onclick="location.href='@Url.Action("HoiThoai", new { id = c.Khach.MaNguoiDung })'">
            <td><strong>@c.Khach.TenNguoiDung</strong> @if (c.SoChuaDoc > 0) { <span class="badge bg-danger">@c.SoChuaDoc mới</span> }</td>
            <td>@(c.TinCuoi?.HinhAnh != null && string.IsNullOrWhiteSpace(c.TinCuoi.NoiDung) ? "🖼 [Hình ảnh]" : TienIch.CatChuoi(c.TinCuoi?.NoiDung, 80))</td><td>@TienIch.NgayGio(c.TinCuoi?.NgayGui)</td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">Chưa có tin nhắn nào.</td></tr> }
    </tbody></table></div>
